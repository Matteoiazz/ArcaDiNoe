---
import '../styles/global.css';
import Icona from '../components/Icona.astro';
import { locale, indirizzoCompleto, mapsDirections } from '../data/locale';
import { orarioGiorno } from '../lib/orari';

interface Props {
  titolo?: string;
  descrizione?: string;
  /** Nasconde la barra azioni su mobile (es. nella pagina Prenota, dove l'azione è il modulo). */
  senzaBarra?: boolean;
  /** Intestazione trasparente sopra la foto di apertura (solo home). */
  sopraFoto?: boolean;
}

const {
  titolo,
  descrizione = `${locale.nome} è pizzeria con forno a legna, ristorante e griglieria a Trenta, Casali del Manco (Cosenza). Sale ampie, giardino, veranda con vista su Cosenza e parcheggio privato. Prenota un tavolo o organizza il tuo evento.`,
  senzaBarra = false,
  sopraFoto = false,
} = Astro.props;

const titoloPagina = titolo ? `${titolo} · ${locale.nome}` : `${locale.nome} · Pizzeria e Ristorante a Trenta, Casali del Manco (CS)`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const voci = [
  { href: '/menu', testo: 'Menu' },
  { href: '/eventi', testo: 'Sale ed eventi' },
  { href: '/dove-siamo', testo: 'Dove siamo' },
];

const giorniSettimana = [1, 2, 3, 4, 5, 6, 0];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: locale.nome,
  description: descrizione,
  servesCuisine: ['Pizza', 'Calabrese', 'Italiana', 'Grigliata', 'Pesce'],
  telephone: locale.telefonoLink,
  url: Astro.site?.toString(),
  image: ogImage.toString(),
  priceRange: '€€',
  acceptsReservations: true,
  hasMenu: new URL('/menu', Astro.site).toString(),
  address: {
    '@type': 'PostalAddress',
    streetAddress: locale.indirizzo.via,
    addressLocality: `${locale.indirizzo.frazione}, ${locale.indirizzo.comune}`,
    postalCode: locale.indirizzo.cap,
    addressRegion: locale.indirizzo.provincia,
    addressCountry: 'IT',
  },
  geo: { '@type': 'GeoCoordinates', latitude: locale.geo.lat, longitude: locale.geo.lng },
  amenityFeature: locale.servizi.map((s) => ({ '@type': 'LocationFeatureSpecification', name: s, value: true })),
  openingHoursSpecification: locale.orari.flatMap((o) =>
    o.fasce.map(([a, b]) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'][o.giorno],
      opens: `${String(Math.floor(a / 60)).padStart(2, '0')}:${String(a % 60).padStart(2, '0')}`,
      closes: `${String(Math.floor((b % 1440) / 60)).padStart(2, '0')}:${String(b % 60).padStart(2, '0')}`,
    })),
  ),
};
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titoloPagina}</title>
    <meta name="description" content={descrizione} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#fffdf4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="restaurant" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={titoloPagina} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class:list={[{ 'con-barra': !senzaBarra }]}>
    <a class="salta" href="#contenuto">Vai al contenuto</a>

    {locale.anteprima && (
      <div class="anteprima" role="note">Anteprima del sito: foto, prezzi e alcuni dati sono dimostrativi.</div>
    )}

    <header class:list={['testata', { 'sopra-foto': sopraFoto }]} data-testata>
      <div class="testata-riga">
        <nav class="nav" aria-label="Principale">
          <button class="apri-menu" type="button" aria-expanded="false" aria-controls="menu-mobile" data-apri-menu>
            <span class="hamburger" aria-hidden="true"></span>
            <span class="apri-menu-testo">Menu</span>
            <span class="sr-only">di navigazione</span>
          </button>
          <ul>
            {voci.map((v) => (
              <li><a href={v.href} aria-current={path === v.href ? 'page' : undefined}>{v.testo}</a></li>
            ))}
          </ul>
        </nav>

        <a href="/" class="marchio" aria-label={`${locale.nome}, home`}>L’Arca di Noè</a>

        <div class="testata-dx">
          <span class="stato" data-stato><span class="stato-punto" aria-hidden="true"></span><span data-stato-testo>Orari</span></span>
          <a class="btn btn-pieno testata-prenota" href="/prenota">Prenota</a>
        </div>
      </div>

      <div class="menu-mobile" id="menu-mobile" hidden data-menu-mobile>
        <ul>
          <li><a href="/">Home</a></li>
          {voci.map((v) => <li><a href={v.href}>{v.testo}</a></li>)}
          <li><a href="/prenota">Prenota un tavolo</a></li>
        </ul>
        <p class="menu-mobile-info">
          <a href={`tel:${locale.telefonoLink}`}>{locale.telefono}</a><br />
          {indirizzoCompleto}
        </p>
      </div>
    </header>

    <main id="contenuto">
      <slot />
    </main>

    <footer class="piede">
      <div class="contenitore">
        <p class="piede-marchio" aria-hidden="true">L’Arca di Noè</p>
        <div class="piede-griglia">
          <div>
            <h2 class="etichetta-mini">Dove siamo</h2>
            <p><a href={mapsDirections} target="_blank" rel="noopener">{indirizzoCompleto}</a></p>
          </div>
          <div>
            <h2 class="etichetta-mini">Prenotazioni</h2>
            <p><a href={`tel:${locale.telefonoLink}`}>{locale.telefono}</a><br /><a href="/prenota">Prenota online</a></p>
          </div>
          <div>
            <h2 class="etichetta-mini">Orari</h2>
            <dl class="piede-orari">
              {giorniSettimana.map((g) => (
                <div data-giorno={g}>
                  <dt>{locale.orari.find((o) => o.giorno === g)!.nome}</dt>
                  <dd>{orarioGiorno(g)}</dd>
                </div>
              ))}
            </dl>
          </div>
          <div>
            <h2 class="etichetta-mini">Il sito</h2>
            <ul class="piede-lista">
              <li><a href="/menu">Menu</a></li>
              <li><a href="/eventi">Sale ed eventi</a></li>
              <li><a href="/dove-siamo">Dove siamo</a></li>
              <li><a href="/privacy">Privacy</a></li>
              <li><a href="/crediti">Crediti foto</a></li>
            </ul>
          </div>
        </div>
        <p class="piede-fondo">© {new Date().getFullYear()} {locale.nome} · {locale.tipo}</p>
      </div>
    </footer>

    {!senzaBarra && (
      <nav class="barra" aria-label="Azioni rapide">
        <a href={`tel:${locale.telefonoLink}`} class="btn btn-bordo"><Icona nome="telefono" /> Chiama</a>
        <a href="/prenota" class="btn btn-pieno">Prenota un tavolo</a>
      </nav>
    )}

    <script>
      import { stato, adessoRoma, orarioGiorno } from '../lib/orari';

      function aggiorna() {
        const s = stato();
        const oggi = adessoRoma().giorno;
        document.querySelectorAll<HTMLElement>('[data-stato]').forEach((el) => {
          el.dataset.aperto = String(s.aperto);
          const t = el.querySelector('[data-stato-testo]');
          if (t) t.textContent = s.aperto ? `Aperto ${s.dettaglio}` : `Chiuso · ${s.dettaglio}`;
        });
        document.querySelectorAll('[data-oggi-orario]').forEach((el) => (el.textContent = orarioGiorno(oggi)));
        document.querySelectorAll<HTMLElement>('[data-giorno]').forEach((el) => {
          el.toggleAttribute('data-oggi', Number(el.dataset.giorno) === oggi);
        });
      }
      aggiorna();
      setInterval(aggiorna, 60_000);

      // Menu mobile
      const bottone = document.querySelector<HTMLButtonElement>('[data-apri-menu]')!;
      const pannello = document.querySelector<HTMLElement>('[data-menu-mobile]')!;
      bottone.addEventListener('click', () => {
        const aperto = bottone.getAttribute('aria-expanded') === 'true';
        bottone.setAttribute('aria-expanded', String(!aperto));
        pannello.hidden = aperto;
        document.querySelector('[data-testata]')?.classList.toggle('menu-aperto', !aperto);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !pannello.hidden) bottone.click();
      });
    </script>
  </body>
</html>

<style>
  .salta {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    background: var(--ink);
    color: var(--bg);
    padding: 0.6rem 1rem;
  }
  .salta:focus {
    top: 1rem;
  }

  .anteprima {
    background: var(--ink);
    color: #f1e4cf;
    font-size: 0.8rem;
    text-align: center;
    padding: 0.4rem var(--gutter);
  }

  /* ---------- Intestazione ---------- */
  .testata {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--linea);
    color: var(--ink);
  }
  .testata-riga {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    min-height: 76px;
    padding-inline: var(--gutter);
  }
  .nav {
    display: flex;
    align-items: center;
  }
  .nav ul {
    display: flex;
    gap: 1.8rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a,
  .apri-menu-testo {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .nav ul a {
    padding-block: 0.4rem;
    border-bottom: 1px solid transparent;
  }
  .nav ul a:hover,
  .nav ul a[aria-current='page'] {
    border-bottom-color: currentColor;
  }
  .marchio {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.7rem, 2.6vw, 2.2rem);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }
  .testata-dx {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.4rem;
  }
  .testata-prenota {
    min-height: 42px;
    padding-inline: 1.4em;
  }
  .stato {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .stato-punto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink-3);
  }
  .stato[data-aperto='true'] .stato-punto {
    background: #43a86a;
    box-shadow: 0 0 0 3px rgba(67, 168, 106, 0.2);
  }

  .apri-menu {
    display: none;
    align-items: center;
    gap: 0.6rem;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .hamburger,
  .hamburger::before,
  .hamburger::after {
    display: block;
    width: 20px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.2s var(--ease);
  }
  .hamburger {
    position: relative;
  }
  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .hamburger::before {
    top: -6px;
  }
  .hamburger::after {
    top: 6px;
  }
  .menu-aperto .hamburger {
    background: transparent;
  }
  .menu-aperto .hamburger::before {
    transform: translateY(6px) rotate(45deg);
  }
  .menu-aperto .hamburger::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  .menu-mobile {
    padding: 0.5rem var(--gutter) 1.8rem;
    background: var(--bg);
    color: var(--ink);
    border-top: 1px solid var(--linea);
  }
  .menu-mobile ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu-mobile li a {
    display: block;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--linea);
    font-family: var(--serif);
    font-size: 2rem;
    line-height: 1.1;
    text-decoration: none;
  }
  .menu-mobile-info {
    margin-top: 1.2rem;
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  @media (max-width: 1000px) {
    .nav ul,
    .stato {
      display: none;
    }
    .apri-menu {
      display: inline-flex;
    }
  }
  @media (max-width: 560px) {
    .testata-riga {
      min-height: 64px;
      gap: 0.5rem;
    }
    .apri-menu-testo {
      display: none;
    }
    .testata-prenota {
      min-height: 38px;
      padding-inline: 1em;
      font-size: 0.7rem;
    }
  }
  @media (min-width: 1001px) {
    .menu-mobile {
      display: none;
    }
  }

  /* Home: intestazione trasparente sopra la foto */
  .sopra-foto {
    position: absolute;
    top: auto;
    inset-inline: 0;
    background: transparent;
    border-color: rgba(255, 253, 244, 0.25);
    color: var(--bg);
  }
  .sopra-foto .stato-punto {
    background: rgba(255, 253, 244, 0.6);
  }
  .sopra-foto.menu-aperto {
    background: var(--bg);
    color: var(--ink);
  }

  /* ---------- Piede ---------- */
  .piede {
    background: var(--bg-scuro);
    color: #f1e4cf;
    padding-top: clamp(56px, 8vw, 104px);
    font-size: 0.95rem;
    overflow: hidden;
  }
  .piede a {
    text-decoration-color: rgba(241, 228, 207, 0.35);
  }
  .piede-marchio {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(4rem, 15vw, 13rem);
    line-height: 0.85;
    letter-spacing: -0.03em;
    color: var(--bg);
    white-space: nowrap;
  }
  .piede-griglia {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.5rem;
    margin-top: clamp(40px, 6vw, 72px);
    padding-top: 2.2rem;
    border-top: 1px solid rgba(241, 228, 207, 0.2);
  }
  .piede-griglia h2 {
    color: #c9b49a;
    margin-bottom: 0.8rem;
  }
  .piede-orari {
    margin: 0;
    display: grid;
    gap: 0.15rem;
    font-variant-numeric: tabular-nums;
  }
  .piede-orari div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    max-width: 230px;
    color: #d9c9b0;
  }
  .piede-orari dd {
    margin: 0;
  }
  .piede-orari div[data-oggi] {
    color: #fff;
    font-weight: 600;
  }
  .piede-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }
  .piede-lista a {
    text-decoration: none;
  }
  .piede-lista a:hover {
    text-decoration: underline;
  }
  .piede-fondo {
    margin-top: clamp(40px, 6vw, 72px);
    padding-block: 1.4rem;
    border-top: 1px solid rgba(241, 228, 207, 0.2);
    color: #a8907c;
    font-size: 0.8rem;
  }
  @media (max-width: 900px) {
    .piede-griglia {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .piede-griglia {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* ---------- Barra azioni mobile ---------- */
  .barra {
    display: none;
  }
  @media (max-width: 760px) {
    body.con-barra {
      padding-bottom: calc(70px + env(safe-area-inset-bottom));
    }
    .barra {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 60;
      display: grid;
      grid-template-columns: 1fr 1.5fr;
      gap: 8px;
      padding: 9px 12px calc(9px + env(safe-area-inset-bottom));
      background: var(--bg);
      border-top: 1px solid var(--linea);
    }
    .barra .btn {
      min-height: 50px;
      padding-inline: 0.8em;
    }
  }
</style>
