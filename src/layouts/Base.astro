---
import '../styles/global.css';
import Arca from '../components/Arca.astro';
import Icona from '../components/Icona.astro';
import { locale, indirizzoCompleto, indirizzoBreve, mapsLink, mapsDirections } from '../data/locale';
import { orarioGiorno } from '../lib/orari';

interface Props {
  titolo?: string;
  descrizione?: string;
  /** Nasconde la barra azioni su mobile (es. nella pagina Prenota, dove l'azione è il modulo). */
  senzaBarra?: boolean;
  /** Intestazione trasparente sopra la foto di apertura (solo home). */
  sopraFoto?: boolean;
}

const {
  titolo,
  descrizione = `${locale.nome} è pizzeria con forno a legna, ristorante e griglieria a Trenta, Casali del Manco (Cosenza). Sale ampie, giardino, veranda con vista su Cosenza e parcheggio privato. Prenota un tavolo o organizza il tuo evento.`,
  senzaBarra = false,
  sopraFoto = false,
} = Astro.props;

const titoloPagina = titolo ? `${titolo} · ${locale.nome}` : `${locale.nome} · Pizzeria e Ristorante a Trenta, Casali del Manco (CS)`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const voci = [
  { href: '/menu', testo: 'Menu' },
  { href: '/eventi', testo: 'Sale ed eventi' },
  { href: '/dove-siamo', testo: 'Dove siamo' },
];

const giorniSettimana = [1, 2, 3, 4, 5, 6, 0];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: locale.nome,
  description: descrizione,
  servesCuisine: ['Pizza', 'Calabrese', 'Italiana', 'Grigliata', 'Pesce'],
  telephone: locale.telefonoLink,
  url: Astro.site?.toString(),
  image: ogImage.toString(),
  priceRange: '€€',
  acceptsReservations: true,
  hasMenu: new URL('/menu', Astro.site).toString(),
  address: {
    '@type': 'PostalAddress',
    streetAddress: locale.indirizzo.via,
    addressLocality: `${locale.indirizzo.frazione}, ${locale.indirizzo.comune}`,
    postalCode: locale.indirizzo.cap,
    addressRegion: locale.indirizzo.provincia,
    addressCountry: 'IT',
  },
  geo: { '@type': 'GeoCoordinates', latitude: locale.geo.lat, longitude: locale.geo.lng },
  amenityFeature: locale.servizi.map((s) => ({ '@type': 'LocationFeatureSpecification', name: s, value: true })),
  openingHoursSpecification: locale.orari.flatMap((o) =>
    o.fasce.map(([a, b]) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'][o.giorno],
      opens: `${String(Math.floor(a / 60)).padStart(2, '0')}:${String(a % 60).padStart(2, '0')}`,
      closes: `${String(Math.floor((b % 1440) / 60)).padStart(2, '0')}:${String(b % 60).padStart(2, '0')}`,
    })),
  ),
};
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titoloPagina}</title>
    <meta name="description" content={descrizione} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="restaurant" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={titoloPagina} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class:list={[{ 'con-barra': !senzaBarra }]}>
    <a class="salta" href="#contenuto">Vai al contenuto</a>

    {locale.anteprima && (
      <div class="anteprima" role="note">Anteprima del sito: foto, prezzi e alcuni dati sono dimostrativi.</div>
    )}

    <div class="info-barra">
      <div class="contenitore info-riga">
        <a href={mapsDirections} target="_blank" rel="noopener"><Icona nome="pin" /> {indirizzoBreve}, Casali del Manco</a>
        <span class="info-dx">
          <span class="stato" data-stato><span class="stato-punto" aria-hidden="true"></span><span data-stato-testo>Orari</span></span>
          <a href={`tel:${locale.telefonoLink}`}><Icona nome="telefono" /> {locale.telefono}</a>
        </span>
      </div>
    </div>

    <header class:list={['testata', { 'sopra-foto': sopraFoto }]} data-testata>
      <div class="contenitore testata-riga">
        <a href="/" class="marchio" aria-label={`${locale.nome}, home`}>
          <Arca class="marchio-arca" />
          <span class="marchio-testo">
            <span class="marchio-nome">L’Arca di Noè</span>
            <span class="marchio-tipo">Pizzeria · Ristorante · Griglieria</span>
          </span>
        </a>

        <nav class="nav" aria-label="Principale">
          <ul>
            {voci.map((v) => (
              <li><a href={v.href} aria-current={path === v.href ? 'page' : undefined}>{v.testo}</a></li>
            ))}
          </ul>
          <a class="btn btn-pieno" href="/prenota">Prenota un tavolo</a>
        </nav>

        <button class="apri-menu" type="button" aria-expanded="false" aria-controls="menu-mobile" data-apri-menu>
          <span class="sr-only">Apri il menu</span>
          <span class="hamburger" aria-hidden="true"></span>
        </button>
      </div>

      <div class="menu-mobile" id="menu-mobile" hidden data-menu-mobile>
        <ul>
          <li><a href="/">Home</a></li>
          {voci.map((v) => <li><a href={v.href}>{v.testo}</a></li>)}
          <li><a href="/prenota">Prenota un tavolo</a></li>
        </ul>
        <p class="menu-mobile-info">
          <a href={`tel:${locale.telefonoLink}`}>{locale.telefono}</a><br />
          {indirizzoCompleto}
        </p>
      </div>
    </header>

    <main id="contenuto">
      <slot />
    </main>

    <footer class="piede">
      <div class="contenitore piede-griglia">
        <div>
          <p class="piede-nome">L’Arca di Noè</p>
          <p class="piede-testo">
            Pizzeria con forno a legna, ristorante e griglieria a Trenta, sulle colline sopra Cosenza.
          </p>
        </div>

        <div>
          <h2 class="piede-titolo">Contatti</h2>
          <p class="piede-testo">
            <a href={mapsLink} target="_blank" rel="noopener">{indirizzoCompleto}</a><br />
            Tel. <a href={`tel:${locale.telefonoLink}`}>{locale.telefono}</a>
          </p>
        </div>

        <div>
          <h2 class="piede-titolo">Orari</h2>
          <dl class="piede-orari">
            {giorniSettimana.map((g) => (
              <div data-giorno={g}>
                <dt>{locale.orari.find((o) => o.giorno === g)!.nome}</dt>
                <dd>{orarioGiorno(g)}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div>
          <h2 class="piede-titolo">Pagine</h2>
          <ul class="piede-lista">
            <li><a href="/menu">Menu</a></li>
            <li><a href="/prenota">Prenota un tavolo</a></li>
            <li><a href="/eventi">Sale ed eventi</a></li>
            <li><a href="/dove-siamo">Dove siamo</a></li>
          </ul>
        </div>
      </div>
      <div class="contenitore piede-fondo">
        <p>© {new Date().getFullYear()} {locale.nome}</p>
        <p><a href="/privacy">Privacy</a> · <a href="/crediti">Crediti foto</a></p>
      </div>
    </footer>

    {!senzaBarra && (
      <nav class="barra" aria-label="Azioni rapide">
        <a href={`tel:${locale.telefonoLink}`} class="barra-voce"><Icona nome="telefono" /> Chiama</a>
        <a href="/prenota" class="barra-voce barra-prenota"><Icona nome="calendario" /> Prenota</a>
      </nav>
    )}

    <script>
      import { stato, adessoRoma, orarioGiorno } from '../lib/orari';

      function aggiorna() {
        const s = stato();
        document.querySelectorAll<HTMLElement>('[data-stato]').forEach((el) => {
          el.dataset.aperto = String(s.aperto);
          const t = el.querySelector('[data-stato-testo]');
          if (t) t.textContent = `${s.aperto ? 'Aperto ora' : 'Chiuso'} · ${s.dettaglio}`;
        });
        const oggi = adessoRoma().giorno;
        document.querySelectorAll('[data-oggi-orario]').forEach((el) => (el.textContent = orarioGiorno(oggi)));
        document.querySelectorAll<HTMLElement>('[data-giorno]').forEach((el) => {
          el.toggleAttribute('data-oggi', Number(el.dataset.giorno) === oggi);
        });
      }
      aggiorna();
      setInterval(aggiorna, 60_000);

      // Menu mobile
      const bottone = document.querySelector<HTMLButtonElement>('[data-apri-menu]')!;
      const pannello = document.querySelector<HTMLElement>('[data-menu-mobile]')!;
      bottone.addEventListener('click', () => {
        const aperto = bottone.getAttribute('aria-expanded') === 'true';
        bottone.setAttribute('aria-expanded', String(!aperto));
        pannello.hidden = aperto;
        document.querySelector('[data-testata]')?.classList.toggle('menu-aperto', !aperto);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !pannello.hidden) bottone.click();
      });    </script>
  </body>
</html>

<style>
  .salta {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    background: var(--ink);
    color: #fff;
    padding: 0.6rem 1rem;
  }
  .salta:focus {
    top: 1rem;
  }

  .anteprima {
    background: #fdf3d8;
    color: #6b5313;
    font-size: 0.85rem;
    text-align: center;
    padding: 0.4rem var(--gutter);
  }

  /* ---------- Barra informazioni ---------- */
  .info-barra {
    background: var(--bg-scuro);
    color: #e9e5dc;
    font-size: 0.875rem;
  }
  .info-riga {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 40px;
  }
  .info-riga a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
  }
  .info-riga a:hover {
    text-decoration: underline;
  }
  .info-riga :global(svg) {
    width: 15px;
    height: 15px;
    opacity: 0.8;
  }
  .info-dx {
    display: flex;
    gap: 1.6rem;
    align-items: center;
  }
  .stato {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .stato-punto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #a39d92;
  }
  .stato[data-aperto='true'] .stato-punto {
    background: #6fcf8e;
  }
  @media (max-width: 760px) {
    .info-riga > a {
      display: none;
    }
    .info-dx {
      width: 100%;
      justify-content: space-between;
    }
  }

  /* ---------- Intestazione ---------- */
  .testata {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #fff;
    border-bottom: 1px solid var(--linea);
  }
  .testata-riga {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 80px;
  }
  .marchio {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--ink);
    margin-right: auto;
  }
  .marchio-arca {
    width: 40px;
    color: var(--accento);
    flex: none;
  }
  .marchio-testo {
    display: grid;
    line-height: 1.1;
  }
  .marchio-nome {
    font-family: var(--serif);
    font-size: 1.45rem;
    white-space: nowrap;
  }
  .marchio-tipo {
    font-size: 0.78rem;
    color: var(--ink-3);
    margin-top: 0.2rem;
    white-space: nowrap;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav ul {
    display: flex;
    gap: 1.8rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a {
    font-weight: 500;
    text-decoration: none;
    color: var(--ink);
    padding-block: 0.4rem;
    border-bottom: 1.5px solid transparent;
    transition: border-color 0.2s var(--ease);
  }
  .nav ul a:hover,
  .nav ul a[aria-current='page'] {
    border-bottom-color: var(--accento);
  }

  .apri-menu {
    display: none;
    width: 48px;
    height: 48px;
    border: 0;
    background: none;
    cursor: pointer;
    place-items: center;
    margin-right: -10px;
  }
  .hamburger,
  .hamburger::before,
  .hamburger::after {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.2s var(--ease), opacity 0.2s;
  }
  .hamburger {
    position: relative;
  }
  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .hamburger::before {
    top: -7px;
  }
  .hamburger::after {
    top: 7px;
  }
  .menu-aperto .hamburger {
    background: transparent;
  }
  .menu-aperto .hamburger::before {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-aperto .hamburger::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  .menu-mobile {
    border-top: 1px solid var(--linea);
    padding: 0.5rem var(--gutter) 1.5rem;
    background: #fff;
  }
  .menu-mobile ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu-mobile li a {
    display: block;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--linea);
    font-family: var(--serif);
    font-size: 1.35rem;
    text-decoration: none;
  }
  .menu-mobile-info {
    margin-top: 1.2rem;
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .nav {
      display: none;
    }
    .apri-menu {
      display: grid;
    }
    .testata-riga {
      min-height: 68px;
    }
  }
  @media (min-width: 901px) {
    .menu-mobile {
      display: none;
    }
  }

  /* Home: intestazione trasparente sopra la foto */
  .sopra-foto {
    position: absolute;
    top: auto;
    inset-inline: 0;
    background: transparent;
    border-color: rgba(255, 255, 255, 0.18);
  }
  .sopra-foto .marchio,
  .sopra-foto .marchio-arca,
  .sopra-foto .nav ul a {
    color: #fff;
  }
  .sopra-foto .marchio-tipo {
    color: rgba(255, 255, 255, 0.82);
  }
  .sopra-foto .nav ul a:hover,
  .sopra-foto .nav ul a[aria-current='page'] {
    border-bottom-color: #fff;
  }
  .sopra-foto .hamburger,
  .sopra-foto .hamburger::before,
  .sopra-foto .hamburger::after {
    background: #fff;
  }
  .sopra-foto.menu-aperto {
    background: #fff;
  }
  .sopra-foto.menu-aperto .marchio,
  .sopra-foto.menu-aperto .marchio-arca {
    color: var(--ink);
  }
  .sopra-foto.menu-aperto .marchio-arca {
    color: var(--accento);
  }
  .sopra-foto.menu-aperto .marchio-tipo {
    color: var(--ink-3);
  }
  .sopra-foto.menu-aperto .hamburger::before,
  .sopra-foto.menu-aperto .hamburger::after {
    background: var(--ink);
  }

  /* ---------- Piede ---------- */
  .piede {
    background: var(--bg-scuro);
    color: #e9e5dc;
    padding-top: clamp(56px, 7vw, 88px);
    font-size: 0.95rem;
  }
  .piede a {
    text-decoration-color: rgba(233, 229, 220, 0.35);
  }
  .piede-griglia {
    display: grid;
    grid-template-columns: 1.3fr 1.2fr 1.2fr 0.8fr;
    gap: 2.5rem;
  }
  .piede-nome {
    font-family: var(--serif);
    font-size: 1.6rem;
    color: #fff;
  }
  .piede-testo {
    margin-top: 0.6rem;
    color: #bfb9ad;
    max-width: 34ch;
  }
  .piede-titolo {
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: #fff;
    margin-bottom: 0.8rem;
  }
  .piede-orari {
    margin: 0;
    display: grid;
    gap: 0.2rem;
    color: #bfb9ad;
    font-variant-numeric: tabular-nums;
  }
  .piede-orari div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    max-width: 240px;
  }
  .piede-orari dd {
    margin: 0;
  }
  .piede-orari div[data-oggi] {
    color: #fff;
    font-weight: 600;
  }
  .piede-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
  .piede-lista a {
    color: #bfb9ad;
    text-decoration: none;
  }
  .piede-lista a:hover {
    color: #fff;
  }
  .piede-fondo {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-top: clamp(40px, 6vw, 64px);
    padding-block: 1.4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    color: #a39d92;
    font-size: 0.85rem;
  }
  @media (max-width: 900px) {
    .piede-griglia {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .piede-griglia {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* ---------- Barra azioni mobile ---------- */
  .barra {
    display: none;
  }
  @media (max-width: 760px) {
    body.con-barra {
      padding-bottom: calc(68px + env(safe-area-inset-bottom));
    }
    .barra {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 60;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      padding: 8px 12px calc(8px + env(safe-area-inset-bottom));
      background: #fff;
      border-top: 1px solid var(--linea);
    }
    .barra-voce {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      min-height: 50px;
      border-radius: var(--raggio);
      text-decoration: none;
      font-weight: 600;
      border: 1px solid var(--ink);
    }
    .barra-voce :global(svg) {
      width: 18px;
      height: 18px;
    }
    .barra-prenota {
      background: var(--accento);
      border-color: var(--accento);
      color: #fff;
    }
  }
</style>
