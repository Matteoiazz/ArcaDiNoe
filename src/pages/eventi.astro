---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Richiesta from '../components/Richiesta.astro';
import { locale } from '../data/locale';
import fotoCosenza from '../assets/foto/cosenza.jpg';

const occasioni = [
  { nome: 'Comunioni e cresime', testo: 'Il pranzo o la cena dopo la cerimonia, con un menu di festa e il giardino dove i bambini possono giocare.' },
  { nome: 'Battesimi', testo: 'Tavolate per le famiglie, con orari tranquilli e un menu concordato in anticipo.' },
  { nome: 'Compleanni e lauree', testo: 'Dalla pizzata con gli amici alla cena con tutti i parenti. La torta potete portarla voi o la organizziamo insieme.' },
  { nome: 'Cene aziendali', testo: 'Menu a prezzo fisso, sale riservate e parcheggio per tutti gli ospiti, anche per gruppi numerosi.' },
  { nome: 'Anniversari e cene di gruppo', testo: 'Associazioni, squadre, rimpatriate: troviamo insieme la soluzione più comoda.' },
  { nome: 'Serate con musica', testo: 'In alcune serate c’è la musica dal vivo. Chiamateci per conoscere le prossime date.' },
];

const servizi = [
  'Sale interne ampie e climatizzate',
  'Veranda coperta e giardino per l’estate',
  'Ampio parcheggio privato',
  'Menu su misura: pizza, cucina calabrese, griglia',
  'Opzioni vegetariane e senza glutine',
  'Locale accessibile in sedia a rotelle',
];
---
<Base titolo="Sale ed eventi" descrizione="Comunioni, battesimi, compleanni, lauree e cene aziendali all’Arca di Noè a Trenta (CS): sale ampie, giardino, veranda, parcheggio privato e menu su misura.">
  <header class="testa">
    <div class="contenitore due-colonne">
      <div>
        <h1>Sale ed eventi</h1>
        <p class="lead">
          L’Arca di Noè è un locale grande: sale interne, veranda e giardino possono accogliere famiglie numerose e
          gruppi, per una festa o una cena di lavoro.
        </p>
        <p class="testo">
          Per ogni evento prepariamo con voi il menu e la disposizione dei tavoli. Raccontateci l’occasione e il numero
          di invitati: vi richiamiamo con disponibilità e proposta.
        </p>
        <a class="btn btn-pieno" href="#richiesta">Richiedi una proposta</a>
      </div>
      <Image src={fotoCosenza} alt="Cosenza vista dall’alto al tramonto" widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 50vw" quality={72} />
    </div>
  </header>

  <section class="sezione sezione-alt" aria-labelledby="t-occasioni">
    <div class="contenitore">
      <h2 id="t-occasioni" class="titolo-sezione">Le occasioni</h2>
      <div class="occasioni">
        {occasioni.map((o) => (
          <div>
            <h3>{o.nome}</h3>
            <p>{o.testo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sezione">
    <div class="contenitore due-colonne allinea-alto">
      <div>
        <h2 class="titolo-sezione">Cosa offriamo</h2>
        <ul class="servizi">
          {servizi.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <div id="richiesta" class="richiesta-box">
        <h2 class="titolo-sezione">Richiedi una proposta</h2>
        <p class="lead">Oppure chiamate il <a href={`tel:${locale.telefonoLink}`}>{locale.telefono}</a>.</p>
        <div class="modulo">
          <Richiesta tipo="evento" />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .testa {
    padding-block: clamp(48px, 7vw, 96px);
  }
  .due-colonne {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: center;
  }
  .allinea-alto {
    align-items: start;
  }
  @media (max-width: 900px) {
    .due-colonne {
      grid-template-columns: 1fr;
    }
  }
  h1 {
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    margin-bottom: 1.1rem;
  }
  .testo {
    margin-top: 1rem;
    color: var(--ink-2);
    max-width: 60ch;
  }
  .testa .btn {
    margin-top: 2rem;
  }
  .testa :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .occasioni {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.2rem 2.5rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .occasioni div {
    padding-top: 1.2rem;
    border-top: 1px solid var(--ink);
  }
  .occasioni h3 {
    font-size: 1.35rem;
  }
  .occasioni p {
    margin-top: 0.5rem;
    color: var(--ink-2);
  }
  @media (max-width: 900px) {
    .occasioni {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .occasioni {
      grid-template-columns: 1fr;
    }
  }

  .servizi {
    list-style: none;
    margin: 1.6rem 0 0;
    padding: 0;
  }
  .servizi li {
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--linea);
  }
  .richiesta-box {
    scroll-margin-top: 110px;
  }
  .richiesta-box .lead {
    margin-top: 0.8rem;
  }
  .modulo {
    margin-top: 2rem;
  }
</style>
