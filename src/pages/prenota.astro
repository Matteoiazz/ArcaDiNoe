---
import Base from '../layouts/Base.astro';
import Richiesta from '../components/Richiesta.astro';
import Icona from '../components/Icona.astro';
import { locale } from '../data/locale';
import { orarioGiorno } from '../lib/orari';

const giorni = [1, 2, 3, 4, 5, 6, 0];
---
<Base titolo="Prenota un tavolo" descrizione={`Prenota un tavolo all’Arca di Noè a Trenta, Casali del Manco: pizzeria, ristorante e griglieria con vista su Cosenza. Chiama il ${locale.telefono}.`} senzaBarra>
  <div class="contenitore pagina">
    <div>
      <h1>Prenota un <em>tavolo</em></h1>
      <p class="lead">
        Indicate giorno, orario e numero di persone: vi confermeremo la prenotazione il prima possibile. Per gruppi numerosi
        e feste visitate la pagina <a href="/eventi">Sale ed eventi</a>.
      </p>
      <div class="modulo">
        <Richiesta tipo="tavolo" />
      </div>
    </div>

    <aside class="laterale">
      <div class="riquadro">
        <h2>Preferite telefonare?</h2>
        <a class="telefono" href={`tel:${locale.telefonoLink}`}><Icona nome="telefono" /> {locale.telefono}</a>
        <p class="stato" data-stato><span data-stato-testo></span></p>
      </div>
      <div class="riquadro">
        <h2>Orari</h2>
        <dl class="orari">
          {giorni.map((g) => (
            <div data-giorno={g}>
              <dt>{locale.orari.find((o) => o.giorno === g)!.nome}</dt>
              <dd>{orarioGiorno(g)}</dd>
            </div>
          ))}
        </dl>
      </div>
    </aside>
  </div>
</Base>

<style>
  .pagina {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    padding-block: clamp(48px, 7vw, 88px) clamp(64px, 9vw, 112px);
    align-items: start;
  }
  @media (max-width: 900px) {
    .pagina {
      grid-template-columns: 1fr;
    }
  }
  h1 {
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 0.95;
    margin-bottom: 1rem;
  }
  .modulo {
    margin-top: 2.2rem;
  }
  .laterale {
    position: sticky;
    top: 110px;
    display: grid;
    gap: 1.25rem;
  }
  .riquadro {
    border-radius: var(--raggio-foto);
    padding: clamp(1.5rem, 3vw, 2rem);
    background: var(--bg-alt);
  }
  .riquadro h2 {
    font-family: var(--sans);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
  }
  .telefono {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--serif);
    font-size: 2.4rem;
    text-decoration: none;
  }
  .telefono :global(svg) {
    width: 0.75em;
    color: var(--accento);
  }
  .stato {
    margin-top: 0.4rem;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .stato[data-aperto='true'] {
    color: var(--aperto);
  }
  @media (max-width: 900px) {
    .laterale {
      position: static;
    }
  }
</style>
