---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icona from '../components/Icona.astro';
import { locale, indirizzoCompleto, mapsDirections } from '../data/locale';
import { orarioGiorno } from '../lib/orari';

import fotoForno from '../assets/foto/forno.jpg';
import fotoCosenza from '../assets/foto/cosenza.jpg';
import fotoMargherita from '../assets/foto/margherita.jpg';
import fotoPorcini from '../assets/foto/porcini.jpg';
import fotoPesce from '../assets/foto/pesce.jpg';
import fotoGriglia from '../assets/foto/griglia.jpg';
import fotoTiramisu from '../assets/foto/tiramisu.jpg';

const cucine = [
  { foto: fotoMargherita, alt: 'Pizza margherita con basilico', titolo: 'La pizzeria', testo: 'Forno a legna, impasti leggeri e le specialità calabresi.', link: '/menu#pizze-rosse' },
  { foto: fotoPorcini, alt: 'Pasta fresca con funghi porcini', titolo: 'La cucina', testo: 'Primi della tradizione e i porcini della Sila.', link: '/menu#primi' },
  { foto: fotoGriglia, alt: 'Salsicce sulla brace', titolo: 'La brace', testo: 'Carne calabrese e grigliate miste da dividere.', link: '/menu#griglia' },
  { foto: fotoPesce, alt: 'Grigliata di pesce con gamberoni e calamari', titolo: 'Il pesce', testo: 'Grigliata di pesce, calamari e gamberoni.', link: '/menu#griglia' },
  { foto: fotoTiramisu, alt: 'Una fetta di tiramisù', titolo: 'I dolci', testo: 'Tiramisù della casa, tartufo di Pizzo, sorbetto.', link: '/menu#dolci' },
];

const spazi = [
  { titolo: 'Sale interne', testo: 'Ampie e climatizzate, per la famiglia e per i grandi gruppi.' },
  { titolo: 'Veranda', testo: 'Coperta e fresca nelle sere d’estate, affacciata sulla valle.' },
  { titolo: 'Giardino', testo: 'Per cenare all’aperto e far giocare i bambini.' },
  { titolo: 'Parcheggio', testo: 'Privato e ampio, proprio all’ingresso.' },
];

const giorni = [1, 2, 3, 4, 5, 6, 0];
---
<Base sopraFoto>
  <!-- Apertura -->
  <section class="apertura" aria-labelledby="titolo-home">
    <Image class="apertura-foto" src={fotoForno} alt="" widths={[800, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" quality={75} />
    <div class="apertura-velo" aria-hidden="true"></div>
    <div class="apertura-testo">
      <h1 id="titolo-home">Pizza, brace e <em>cucina calabrese</em></h1>
      <p class="etichetta-mini">Trenta · Casali del Manco · sopra Cosenza</p>
      <div class="apertura-azioni">
        <a class="btn btn-pieno" href="/prenota">Prenota un tavolo</a>
        <a class="btn btn-bordo-chiaro" href="/menu">Guarda il menu</a>
      </div>
    </div>
  </section>

  <!-- Benvenuto -->
  <section class="benvenuto">
    <div class="contenitore">
      <p class="benvenuto-testo">
        Sulla collina di Trenta, con Cosenza ai piedi, l’Arca di Noè è il posto dove si sta a tavola{' '}
        <em>tutti insieme</em>: la pizza del forno a legna, i piatti della cucina calabrese e la brace, sotto lo stesso tetto.
      </p>
      <ul class="fatti etichetta-mini">
        <li>Sale ampie</li>
        <li>Giardino e veranda</li>
        <li>Vista su Cosenza</li>
        <li>Parcheggio privato</li>
      </ul>
    </div>
  </section>

  <!-- Le cucine -->
  <section class="cucine-sez" aria-labelledby="t-cucine">
    <div class="contenitore cucine-testa">
      <h2 id="t-cucine" class="titolo-sezione">Cosa si mangia <em>all’Arca</em></h2>
      <a class="btn btn-bordo" href="/menu">Il menu completo</a>
    </div>
    <ul class="cucine" role="list">
      {cucine.map((c) => (
        <li>
          <a class="cucina" href={c.link}>
            <Image src={c.foto} alt={c.alt} widths={[400, 700]} sizes="(max-width: 700px) 78vw, 26vw" quality={75} />
            <span class="cucina-testo">
              <span class="cucina-titolo">{c.titolo}</span>
              <span class="cucina-desc">{c.testo}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Feste ed eventi -->
  <section class="feste" aria-labelledby="t-feste">
    <div class="contenitore feste-griglia">
      <div>
        <h2 id="t-feste" class="feste-titolo">Comunioni, compleanni, <em>cene di gruppo</em></h2>
        <p class="feste-lead">
          L’Arca di Noè è un locale grande: le sale, la veranda e il giardino accolgono comodamente famiglie numerose e
          gruppi. Il menu della festa lo prepariamo insieme a voi.
        </p>
        <dl class="spazi">
          {spazi.map((s) => (
            <div>
              <dt>{s.titolo}</dt>
              <dd>{s.testo}</dd>
            </div>
          ))}
        </dl>
        <a class="btn btn-chiaro" href="/eventi">Organizza la tua festa</a>
      </div>
      <figure class="feste-foto">
        <Image src={fotoCosenza} alt="La valle di Cosenza al tramonto" widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 45vw" quality={75} />
      </figure>
    </div>
  </section>

  <!-- Informazioni -->
  <section class="info sezione" aria-labelledby="t-info">
    <div class="contenitore info-griglia">
      <div>
        <h2 id="t-info" class="titolo-sezione">Vieni a <em>trovarci</em></h2>
        <p class="info-indirizzo">{indirizzoCompleto}</p>
        <p class="info-stato" data-stato><span class="stato-punto" aria-hidden="true"></span><span data-stato-testo>Orari</span></p>

        <div class="fisarmonica">
          <details open>
            <summary>Orari di apertura</summary>
            <dl class="orari">
              {giorni.map((g) => (
                <div data-giorno={g}>
                  <dt>{locale.orari.find((o) => o.giorno === g)!.nome}</dt>
                  <dd>{orarioGiorno(g)}</dd>
                </div>
              ))}
            </dl>
          </details>
          <details>
            <summary>Prenotazioni</summary>
            <p>
              Potete prenotare <a href="/prenota">online</a> o chiamando il
              <a href={`tel:${locale.telefonoLink}`}>{locale.telefono}</a>. Il venerdì e il sabato sera consigliamo di
              prenotare con qualche giorno di anticipo.
            </p>
          </details>
          <details>
            <summary>Come arrivare</summary>
            <p>
              Da Cosenza si sale verso la Sila in direzione Casali del Manco: in pochi minuti si arriva a Trenta. Il
              parcheggio privato è all’ingresso del locale.
            </p>
            <p><a href={mapsDirections} target="_blank" rel="noopener">Apri le indicazioni in Google Maps</a></p>
          </details>
          <details>
            <summary>Allergie e senza glutine</summary>
            <p>
              Su richiesta prepariamo la pizza con impasto senza glutine. Per allergie e intolleranze avvisateci al momento
              della prenotazione e chiedete al personale: vi indicheremo i piatti adatti.
            </p>
          </details>
          <details>
            <summary>Gruppi e feste</summary>
            <p>
              Per comunioni, compleanni, lauree e cene aziendali prepariamo menu su misura e riserviamo gli spazi.
              <a href="/eventi">Scopri le sale e chiedi una proposta</a>.
            </p>
          </details>
          <details>
            <summary>Asporto</summary>
            <p>Le pizze si possono ordinare da asporto: chiamate il <a href={`tel:${locale.telefonoLink}`}>{locale.telefono}</a>.</p>
          </details>
        </div>

        <div class="info-azioni">
          <a class="btn btn-pieno" href="/prenota">Prenota un tavolo</a>
          <a class="btn btn-bordo" href={mapsDirections} target="_blank" rel="noopener"><Icona nome="pin" /> Indicazioni</a>
        </div>
      </div>
      <figure class="info-foto">
        <Image src={fotoForno} alt="Una pizza nel forno a legna, accanto alla brace" widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 45vw" quality={75} />
      </figure>
    </div>
  </section>
</Base>

<style>
  /* ---------- Apertura ---------- */
  .apertura {
    position: relative;
    min-height: min(100svh, 940px);
    display: grid;
    place-items: center;
    color: var(--bg);
    overflow: hidden;
    text-align: center;
  }
  .apertura :global(.apertura-foto) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 35% 60%;
    animation: avvicina 14s var(--ease) both;
  }
  @keyframes avvicina {
    from {
      transform: scale(1.08);
    }
    to {
      transform: scale(1);
    }
  }
  .apertura-velo {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(30, 10, 4, 0.55) 0%, rgba(30, 10, 4, 0.15) 30%, rgba(30, 10, 4, 0.25) 60%, rgba(30, 10, 4, 0.7) 100%);
  }
  .apertura-testo {
    position: relative;
    padding: 120px var(--gutter) 80px;
    display: grid;
    justify-items: center;
  }
  .apertura h1 {
    font-size: clamp(3.4rem, 10vw, 9rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
    max-width: 11ch;
  }
  .apertura h1 em {
    display: block;
    color: inherit;
  }
  .apertura .etichetta-mini {
    margin-top: 1.6rem;
    color: rgba(255, 253, 244, 0.9);
  }
  .apertura-azioni {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.2rem;
  }
  @media (max-width: 560px) {
    .apertura-azioni {
      width: 100%;
    }
    .apertura-azioni .btn {
      flex: 1 1 100%;
    }
  }

  /* ---------- Benvenuto ---------- */
  .benvenuto {
    padding-block: clamp(80px, 12vw, 160px);
    text-align: center;
  }
  .benvenuto-testo {
    font-family: var(--serif);
    font-size: clamp(1.9rem, 3.6vw, 3.1rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    max-width: 30ch;
    margin-inline: auto;
  }
  .benvenuto-testo em {
    color: var(--accento);
  }
  .fatti {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 1.2rem;
    list-style: none;
    margin: 2.6rem 0 0;
    padding: 0;
    color: var(--ink-2);
  }
  .fatti li {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }
  .fatti li + li::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accento);
  }

  /* ---------- Cucine ---------- */
  .cucine-sez {
    padding-bottom: clamp(80px, 11vw, 150px);
  }
  .cucine-testa {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: clamp(1.8rem, 3vw, 2.8rem);
  }
  .cucine {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(250px, 24vw, 340px);
    gap: clamp(12px, 1.5vw, 20px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 var(--gutter) 0.5rem;
    scroll-padding-inline: var(--gutter);
    margin: 0;
    list-style: none;
    scrollbar-width: none;
  }
  .cucine::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 1400px) {
    .cucine {
      grid-auto-flow: row;
      grid-template-columns: repeat(5, 1fr);
      max-width: var(--max);
      margin-inline: auto;
    }
  }
  .cucine li {
    scroll-snap-align: start;
  }
  .cucina {
    position: relative;
    display: block;
    border-radius: var(--raggio-foto);
    overflow: hidden;
    aspect-ratio: 3 / 4.3;
    color: var(--bg);
    text-decoration: none;
    isolation: isolate;
  }
  .cucina :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
    transition: transform 0.8s var(--ease);
  }
  .cucina::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, transparent 40%, rgba(30, 10, 4, 0.82));
  }
  .cucina:hover :global(img) {
    transform: scale(1.05);
  }
  .cucina-testo {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.4rem;
    display: grid;
    gap: 0.35rem;
  }
  .cucina-titolo {
    font-family: var(--serif);
    font-style: italic;
    font-size: 2.2rem;
    line-height: 1;
  }
  .cucina-desc {
    font-size: 0.925rem;
    color: rgba(255, 253, 244, 0.88);
  }

  /* ---------- Feste ---------- */
  .feste {
    background: var(--accento);
    color: var(--bg);
    padding-block: clamp(80px, 11vw, 150px);
  }
  .feste-griglia {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }
  .feste-titolo {
    font-size: clamp(2.8rem, 6vw, 5.2rem);
    line-height: 0.95;
  }
  .feste-titolo em {
    display: block;
    color: inherit;
  }
  .feste-lead {
    margin-top: 1.6rem;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    color: rgba(255, 253, 244, 0.9);
    max-width: 52ch;
  }
  .spazi {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.6rem 2rem;
    margin: 2.4rem 0 2.6rem;
  }
  .spazi div {
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 253, 244, 0.35);
  }
  .spazi dt {
    font-family: var(--serif);
    font-size: 1.6rem;
    line-height: 1.1;
  }
  .spazi dd {
    margin: 0.35rem 0 0;
    font-size: 0.95rem;
    color: rgba(255, 253, 244, 0.82);
  }
  .feste-foto {
    margin: 0;
  }
  .feste-foto :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 999px 999px var(--raggio-foto) var(--raggio-foto);
  }
  @media (max-width: 900px) {
    .feste-griglia {
      grid-template-columns: 1fr;
    }
    .feste-foto {
      max-width: 460px;
    }
  }
  @media (max-width: 480px) {
    .spazi {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Informazioni ---------- */
  .info-griglia {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }
  .info-indirizzo {
    margin-top: 1.4rem;
    font-family: var(--serif);
    font-size: 1.6rem;
    line-height: 1.2;
  }
  .info-stato {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.8rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  .info-stato .stato-punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink-3);
  }
  .info-stato[data-aperto='true'] {
    color: var(--aperto);
  }
  .info-stato[data-aperto='true'] .stato-punto {
    background: #43a86a;
  }
  .fisarmonica {
    margin-top: 2.2rem;
    border-top: 1px solid var(--ink);
  }
  .fisarmonica details {
    border-bottom: 1px solid var(--linea);
  }
  .fisarmonica summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.1rem;
    cursor: pointer;
    list-style: none;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .fisarmonica summary::-webkit-details-marker {
    display: none;
  }
  .fisarmonica summary::after {
    content: '+';
    font-family: var(--serif);
    font-size: 1.7rem;
    font-weight: 400;
    line-height: 1;
    color: var(--accento);
    transition: transform 0.25s var(--ease);
  }
  .fisarmonica details[open] summary::after {
    transform: rotate(45deg);
  }
  .fisarmonica details > :not(summary) {
    margin-bottom: 1.2rem;
    color: var(--ink-2);
    max-width: 56ch;
  }
  .fisarmonica details p + p {
    margin-top: 0.6rem;
  }
  .fisarmonica .orari {
    max-width: 420px;
  }
  .info-azioni {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.2rem;
  }
  .info-foto {
    position: sticky;
    top: 100px;
    margin: 0;
  }
  .info-foto :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--raggio-foto);
  }
  @media (max-width: 900px) {
    .info-griglia {
      grid-template-columns: 1fr;
    }
    .info-foto {
      display: none;
    }
  }
</style>
