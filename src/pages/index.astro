---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Vista from '../components/Vista.astro';
import Icona from '../components/Icona.astro';
import Arca from '../components/Arca.astro';
import { locale, mapsDirections, indirizzoCompleto } from '../data/locale';
import { menu, euro } from '../data/menu';
import { orarioGiorno } from '../lib/orari';

import fotoForno from '../assets/foto/forno.jpg';
import fotoCosenza from '../assets/foto/cosenza.jpg';
import fotoMargherita from '../assets/foto/margherita.jpg';
import fotoPorcini from '../assets/foto/porcini.jpg';
import fotoPesce from '../assets/foto/pesce.jpg';
import fotoGriglia from '../assets/foto/griglia.jpg';

const trova = (cat: string, nome: string) => {
  const p = menu.find((c) => c.id === cat)!.piatti.find((x) => x.nome === nome)!;
  return { ...p, cat };
};

const cucine = [
  {
    nome: 'Pizzeria',
    testo: 'Impasto lievitato a lungo e cottura nel forno a legna. C’è anche l’impasto senza glutine.',
    piatti: [trova('pizze-rosse', 'Calabrese'), trova('pizze-bianche', 'Silana'), trova('pizze-rosse', 'Crudo e rucola')],
    link: '/menu#pizze-rosse',
  },
  {
    nome: 'Cucina',
    testo: 'Piatti di casa e di montagna: porcini della Sila, pasta fatta a mano, i sapori di Cosenza.',
    piatti: [trova('antipasti', 'Patate ’mpacchiuse'), trova('primi', 'Fusilli ai funghi porcini'), trova('primi', 'Riso zucchine e gamberetti')],
    link: '/menu#primi',
  },
  {
    nome: 'Griglia',
    testo: 'Carne calabrese e pesce cotti sulla brace, da dividere al centro del tavolo.',
    piatti: [trova('griglia', 'Grigliata mista di carne'), trova('griglia', 'Grigliata di pesce'), trova('griglia', 'Tagliata di manzo')],
    link: '/menu#griglia',
  },
];

const plusVista = [
  { icona: 'foglia', testo: 'Giardino e veranda, freschi anche d’estate' },
  { icona: 'auto', testo: 'Ampio parcheggio privato' },
  { icona: 'fuoco', testo: 'Forno a legna a vista' },
  { icona: 'persone', testo: 'Sale climatizzate, accessibili in sedia a rotelle' },
  { icona: 'musica', testo: 'Serate con musica dal vivo' },
] as const;

const giorni = [1, 2, 3, 4, 5, 6, 0];
---
<Base>
  <!-- ============ 1. La vista ============ -->
  <section class="apertura" aria-labelledby="titolo-home">
    <Vista />
    <div class="contenitore apertura-testo">
      <p class="insegna" data-stato data-insegna>
        <span class="insegna-parola" data-insegna-parola>Aperto</span>
        <span class="insegna-dettaglio" data-stato-testo></span>
      </p>
      <h1 id="titolo-home" class="apertura-titolo">
        L’Arca di Noè, <span>sopra le luci di Cosenza.</span>
      </h1>
      <p class="apertura-sotto">
        Pizzeria con forno a legna, cucina calabrese e griglia a Trenta, Casali del Manco. Giardino, veranda e
        parcheggio privato.
      </p>
      <div class="apertura-azioni">
        <a class="btn btn-luce" href="/prenota"><Icona nome="calendario" /> Prenota un tavolo</a>
        <a class="btn btn-linea" href={`tel:${locale.telefonoLink}`}><Icona nome="telefono" /> {locale.telefono}</a>
      </div>
    </div>
    <a class="apertura-giu" href="#cucine" aria-label="Scopri le cucine">
      <span></span>
    </a>
  </section>

  <!-- ============ 2. Tre cucine ============ -->
  <section id="cucine" class="sezione cucine">
    <div class="contenitore cucine-griglia">
      <div class="cucine-foto">
        <Image quality={70} src={fotoForno} alt="Una pizza nel forno a legna, accanto alla brace" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 46vw" />
      </div>
      <div class="cucine-testo">
        <h2 class="titolo-sezione">Un forno a legna, <em>tre cucine.</em></h2>
        <p class="lead">
          Al tavolo c’è chi vuole la pizza, chi i primi e chi la brace. Qui si ordina tutto insieme.
        </p>

        <ol class="cucine-lista">
          {cucine.map((c) => (
            <li class="cucina">
              <h3 class="cucina-nome">{c.nome}</h3>
              <p class="cucina-testo">{c.testo}</p>
              <ul class="righe">
                {c.piatti.map((p) => (
                  <li class="riga">
                    <span class="riga-nome">{p.nome}</span>
                    <span class="puntini" aria-hidden="true"></span>
                    <span class="riga-prezzo">€ {euro(p.prezzo)}</span>
                  </li>
                ))}
              </ul>
              <a class="cucina-link" href={c.link}>
                Tutto il menu {c.nome.toLowerCase()} <Icona nome="freccia" />
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ 3. Piatti ============ -->
  <section class="striscia" aria-label="Alcuni piatti">
    <figure>
      <Image quality={70} src={fotoMargherita} alt="Pizza margherita con basilico" widths={[400, 700]} sizes="(max-width: 700px) 70vw, 25vw" />
      <figcaption>Margherita</figcaption>
    </figure>
    <figure>
      <Image quality={70} src={fotoPorcini} alt="Pasta fresca con funghi porcini" widths={[400, 700]} sizes="(max-width: 700px) 70vw, 25vw" />
      <figcaption>Pasta ai porcini</figcaption>
    </figure>
    <figure>
      <Image quality={70} src={fotoPesce} alt="Grigliata di pesce con gamberoni, calamari e cozze" widths={[400, 700]} sizes="(max-width: 700px) 70vw, 25vw" />
      <figcaption>Grigliata di pesce</figcaption>
    </figure>
    <figure>
      <Image quality={70} src={fotoGriglia} alt="Salsicce sulla brace" widths={[400, 700]} sizes="(max-width: 700px) 70vw, 25vw" />
      <figcaption>Salsiccia alla brace</figcaption>
    </figure>
  </section>

  <!-- ============ 4. Il posto ============ -->
  <section class="sezione posto">
    <div class="contenitore posto-griglia">
      <div class="posto-testo">
        <h2 class="titolo-sezione">Si cena con <em>tutta la valle</em> davanti.</h2>
        <p class="lead">
          Da Trenta lo sguardo arriva fino a Cosenza e alla Catena Costiera. D’estate si mangia in giardino o sotto la
          veranda, d’inverno nelle sale.
        </p>
        <ul class="plus">
          {plusVista.map((p) => (
            <li><Icona nome={p.icona} /> {p.testo}</li>
          ))}
        </ul>
      </div>
      <figure class="posto-foto">
        <Image quality={70} src={fotoCosenza} alt="Panorama di Cosenza al tramonto visto dall’alto" widths={[600, 1000, 1500]} sizes="(max-width: 900px) 100vw, 55vw" />
        <figcaption>Cosenza al tramonto</figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ 5. Eventi ============ -->
  <section class="sezione eventi">
    <div class="contenitore eventi-riga">
      <div>
        <h2 class="titolo-sezione">Comunioni, compleanni, <em>cene di lavoro.</em></h2>
        <p class="lead">
          Sale grandi, giardino e parcheggio per tutti gli invitati. Menu concordato con voi, anche con la musica dal vivo.
        </p>
      </div>
      <div class="eventi-azioni">
        <a class="btn btn-luce" href="/eventi">Organizza un evento <Icona nome="freccia" /></a>
      </div>
    </div>
  </section>

  <!-- ============ 6. Orari e strada ============ -->
  <section class="sezione orari" aria-labelledby="titolo-orari">
    <div class="contenitore orari-griglia">
      <div>
        <h2 id="titolo-orari" class="titolo-sezione">Quando <em>siamo accesi.</em></h2>
        <dl class="tabella-orari">
          {giorni.map((g) => (
            <div data-giorno={g} class:list={[{ chiuso: orarioGiorno(g) === 'Chiuso' }]}>
              <dt>{locale.orari.find((o) => o.giorno === g)!.nome}</dt>
              <span class="puntini" aria-hidden="true"></span>
              <dd>{orarioGiorno(g)}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="strada">
        <Arca class="strada-arca" />
        <p class="strada-indirizzo">{indirizzoCompleto}</p>
        <p class="strada-nota">Pochi minuti in auto da Cosenza, salendo verso la Sila. Parcheggio privato all’ingresso.</p>
        <div class="strada-azioni">
          <a class="btn btn-luce" href={mapsDirections} target="_blank" rel="noopener"><Icona nome="pin" /> Indicazioni</a>
          <a class="btn btn-linea" href="/dove-siamo">Mappa e dettagli</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 7. Chiusura ============ -->
  <section class="chiusura">
    <div class="contenitore">
      <p class="chiusura-titolo">Ci vediamo <em>stasera?</em></p>
      <div class="chiusura-azioni">
        <a class="btn btn-luce" href="/prenota"><Icona nome="calendario" /> Prenota un tavolo</a>
        <a class="btn btn-linea" href={`tel:${locale.telefonoLink}`}><Icona nome="telefono" /> Chiama</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { stato } from '../lib/orari';

  // L'insegna: "Aperto" acceso o "Chiuso" spento, con il dettaglio dell'orario.
  function insegna(s: { aperto: boolean }) {
    const el = document.querySelector<HTMLElement>('[data-insegna]');
    const parola = el?.querySelector('[data-insegna-parola]');
    if (!el || !parola) return;
    el.dataset.aperto = String(s.aperto);
    parola.textContent = s.aperto ? 'Aperto' : 'Chiuso';
    el.classList.add('pronta');
  }
  insegna(stato());
  document.addEventListener('stato', (e) => insegna((e as CustomEvent).detail));
</script>

<style>
  /* ---------- Apertura ---------- */
  .apertura {
    position: relative;
    min-height: max(640px, calc(100svh - 68px));
    display: flex;
    align-items: flex-start;
    overflow: hidden;
    isolation: isolate;
  }
  .apertura-testo {
    position: relative;
    z-index: 1;
    padding-top: clamp(40px, 9vh, 110px);
    padding-bottom: 38vh;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .insegna {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: clamp(1.2rem, 3vh, 2rem);
  }
  .insegna-parola {
    font-family: var(--display);
    font-weight: 800;
    font-stretch: 75%;
    text-transform: uppercase;
    font-size: clamp(5.2rem, 19vw, 13rem);
    line-height: 0.82;
    letter-spacing: -0.015em;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in oklab, var(--carta) 35%, transparent);
    transition: color 0.6s var(--ease), text-shadow 0.6s var(--ease);
  }
  .insegna-dettaglio {
    font-family: var(--display);
    font-weight: 600;
    font-stretch: 90%;
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    color: var(--carta-2);
    min-height: 1.4em;
  }
  .insegna[data-aperto='true'].pronta .insegna-parola {
    color: var(--luce-forte);
    -webkit-text-stroke: 0;
    text-shadow:
      0 0 18px rgba(244, 197, 106, 0.55),
      0 0 60px rgba(244, 197, 106, 0.35);
    animation: accendi 1.4s steps(1, end) both;
  }
  .insegna[data-aperto='true'] .insegna-dettaglio {
    color: var(--carta);
  }
  .insegna[data-aperto='false'] .insegna-parola {
    -webkit-text-stroke-color: color-mix(in oklab, var(--carta) 55%, transparent);
  }

  /* L'insegna al neon che si accende: due sfarfallii e poi luce piena. */
  @keyframes accendi {
    0% { opacity: 0.25; }
    12% { opacity: 1; }
    18% { opacity: 0.35; }
    30% { opacity: 1; }
    36% { opacity: 0.6; }
    44%, 100% { opacity: 1; }
  }

  .apertura-titolo {
    font-size: clamp(2rem, 4.6vw, 3.6rem);
    max-width: 18ch;
    color: var(--carta);
  }
  .apertura-titolo span {
    color: var(--luce);
  }
  .apertura-sotto {
    margin-top: 1rem;
    color: var(--carta-2);
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    max-width: 50ch;
  }
  .apertura-azioni {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.8rem;
  }

  .apertura-giu {
    position: absolute;
    left: 50%;
    bottom: 26px;
    z-index: 1;
    width: 44px;
    height: 44px;
    translate: -50% 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
  }
  .apertura-giu span {
    width: 2px;
    height: 28px;
    background: linear-gradient(var(--luce), transparent);
    animation: scendi 2.4s var(--ease) infinite;
  }
  @keyframes scendi {
    0% { transform: translateY(-8px); opacity: 0; }
    40% { opacity: 1; }
    100% { transform: translateY(10px); opacity: 0; }
  }

  @media (max-width: 640px) {
    .apertura-testo {
      padding-bottom: 30vh;
    }
    .apertura-azioni .btn {
      flex: 1 1 100%;
    }
    /* Su telefono la chiamata è già nella barra in basso */
    .apertura-azioni .btn-linea {
      display: none;
    }
    .apertura-giu {
      display: none;
    }
  }

  /* ---------- Cucine ---------- */
  .cucine {
    background: var(--notte-0);
  }
  .cucine-griglia {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }
  .cucine-foto {
    position: sticky;
    top: 100px;
  }
  .cucine-foto :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--raggio);
    box-shadow: 0 30px 80px -30px rgba(244, 140, 60, 0.35);
  }
  .cucine-lista {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    display: grid;
    gap: clamp(2.5rem, 4vw, 3.5rem);
  }
  .cucina {
    padding-top: 1.6rem;
    border-top: 1px solid var(--notte-3);
  }
  .cucina-nome {
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    color: var(--luce);
  }
  .cucina-testo {
    margin-top: 0.6rem;
    color: var(--carta-2);
    max-width: 52ch;
  }
  .righe {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
    display: grid;
    gap: 0.55rem;
  }
  .riga {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 1.1rem;
  }
  .riga-prezzo {
    font-variant-numeric: tabular-nums;
    color: var(--carta);
    font-weight: 700;
  }
  .cucina-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.1rem;
    color: var(--luce);
    font-weight: 700;
    text-decoration: none;
    min-height: 40px;
  }
  .cucina-link :global(svg) {
    width: 18px;
    transition: translate 0.3s var(--ease);
  }
  .cucina-link:hover :global(svg) {
    translate: 4px 0;
  }

  @media (max-width: 900px) {
    .cucine-griglia {
      grid-template-columns: 1fr;
    }
    .cucine-foto {
      position: static;
    }
    .cucine-foto :global(img) {
      aspect-ratio: 4 / 3;
    }
  }

  /* ---------- Striscia piatti ---------- */
  .striscia {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
    background: var(--notte-0);
  }
  .striscia figure {
    position: relative;
    margin: 0;
    overflow: hidden;
  }
  .striscia :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    transition: scale 0.8s var(--ease);
  }
  .striscia figure:hover :global(img) {
    scale: 1.04;
  }
  .striscia figcaption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 2.5rem 1rem 0.9rem;
    background: linear-gradient(transparent, rgba(6, 12, 23, 0.85));
    font-family: var(--display);
    font-weight: 700;
    font-stretch: 88%;
    font-size: 1.1rem;
  }
  @media (max-width: 700px) {
    .striscia {
      grid-auto-flow: column;
      grid-template-columns: none;
      grid-auto-columns: 72vw;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .striscia figure {
      scroll-snap-align: start;
    }
  }

  /* ---------- Posto ---------- */
  .posto-griglia {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }
  .plus {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  .plus li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 1.1rem;
  }
  .plus :global(svg) {
    width: 24px;
    height: 24px;
    flex: none;
    color: var(--luce);
  }
  .posto-foto {
    margin: 0;
  }
  .posto-foto :global(img) {
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    border-radius: var(--raggio);
    filter: saturate(0.9);
  }
  .posto-foto figcaption {
    margin-top: 0.7rem;
    font-size: 0.9rem;
    color: var(--carta-3);
  }
  @media (max-width: 900px) {
    .posto-griglia {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Eventi ---------- */
  .eventi {
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(244, 197, 106, 0.16), transparent 55%),
      var(--notte-2);
  }
  .eventi-riga {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2.5rem;
    align-items: end;
  }
  @media (max-width: 800px) {
    .eventi-riga {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Orari ---------- */
  .orari {
    background: var(--notte-0);
  }
  .orari-griglia {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(3rem, 7vw, 7rem);
  }
  .tabella-orari {
    margin: 2.2rem 0 0;
    display: grid;
    gap: 0.75rem;
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    font-variant-numeric: tabular-nums;
    max-width: 560px;
  }
  .tabella-orari div {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
  }
  .tabella-orari dt {
    font-family: var(--display);
    font-weight: 650;
    font-stretch: 90%;
  }
  .tabella-orari dd {
    margin: 0;
  }
  .tabella-orari .chiuso {
    color: var(--carta-3);
  }
  .tabella-orari div[data-oggi] {
    color: var(--luce-forte);
  }
  .tabella-orari div[data-oggi] dt::after {
    content: ' · oggi';
    font-weight: 500;
    color: var(--luce);
  }
  .strada {
    align-self: end;
    padding: clamp(1.8rem, 3vw, 2.6rem);
    border-radius: var(--raggio);
    background: var(--notte-2);
  }
  .strada-arca {
    width: 64px;
    color: var(--carta);
  }
  .strada-indirizzo {
    margin-top: 1.2rem;
    font-family: var(--display);
    font-weight: 700;
    font-stretch: 88%;
    font-size: clamp(1.4rem, 2.4vw, 1.8rem);
    line-height: 1.15;
  }
  .strada-nota {
    margin-top: 0.8rem;
    color: var(--carta-2);
  }
  .strada-azioni {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.6rem;
  }
  @media (max-width: 900px) {
    .orari-griglia {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Chiusura ---------- */
  .chiusura {
    padding-block: clamp(90px, 14vw, 180px);
    text-align: center;
    background:
      radial-gradient(60% 80% at 50% 120%, rgba(244, 197, 106, 0.22), transparent 70%),
      var(--notte-1);
  }
  .chiusura-titolo {
    font-family: var(--display);
    font-weight: 800;
    font-stretch: 76%;
    font-size: clamp(3.2rem, 11vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
  }
  .chiusura-titolo em {
    font-style: normal;
    color: var(--luce);
  }
  .chiusura-azioni {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.4rem;
  }
</style>
