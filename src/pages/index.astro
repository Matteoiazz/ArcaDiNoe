---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icona from '../components/Icona.astro';
import { locale, indirizzoCompleto, mapsDirections } from '../data/locale';
import { orarioGiorno } from '../lib/orari';

import fotoForno from '../assets/foto/forno.jpg';
import fotoCosenza from '../assets/foto/cosenza.jpg';
import fotoMargherita from '../assets/foto/margherita.jpg';
import fotoPorcini from '../assets/foto/porcini.jpg';
import fotoPesce from '../assets/foto/pesce.jpg';

const cucine = [
  {
    foto: fotoMargherita,
    alt: 'Pizza margherita con basilico',
    titolo: 'Pizzeria',
    testo: 'Pizze cotte nel forno a legna, dalle classiche alle specialità calabresi con ’nduja, salsiccia e porcini. Su richiesta anche con impasto senza glutine.',
    link: '/menu#pizze-rosse',
  },
  {
    foto: fotoPorcini,
    alt: 'Pasta fresca con funghi porcini',
    titolo: 'Cucina',
    testo: 'Antipasti della casa, primi della tradizione cosentina e piatti di montagna: funghi porcini della Sila, patate ’mpacchiuse, pasta fatta a mano.',
    link: '/menu#primi',
  },
  {
    foto: fotoPesce,
    alt: 'Grigliata di pesce con gamberoni e calamari',
    titolo: 'Griglia',
    testo: 'Carne calabrese e pesce cotti alla brace: grigliate miste da dividere, tagliata di manzo, salsiccia, calamari e gamberoni.',
    link: '/menu#griglia',
  },
];

const spazi = [
  { titolo: 'Sale interne', testo: 'Ampie e climatizzate, adatte sia alla cena in famiglia sia ai grandi gruppi.' },
  { titolo: 'Veranda', testo: 'Coperta e fresca anche nelle sere d’estate, con la vista sulla valle.' },
  { titolo: 'Giardino', testo: 'Spazio all’aperto per cenare in estate e far giocare i bambini.' },
  { titolo: 'Parcheggio privato', testo: 'Ampio, all’ingresso del locale, per clienti e invitati.' },
];

const giorni = [1, 2, 3, 4, 5, 6, 0];
---
<Base sopraFoto>
  <!-- Apertura -->
  <section class="apertura" aria-labelledby="titolo-home">
    <Image class="apertura-foto" src={fotoForno} alt="" widths={[800, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" quality={72} />
    <div class="apertura-velo" aria-hidden="true"></div>
    <div class="contenitore apertura-testo">
      <h1 id="titolo-home">Pizzeria, ristorante e griglieria a Trenta, sopra Cosenza</h1>
      <p>Forno a legna, cucina calabrese e brace. Sale ampie, giardino e veranda con vista sulla valle.</p>
      <div class="apertura-azioni">
        <a class="btn btn-chiaro" href="/prenota">Prenota un tavolo</a>
        <a class="btn btn-bordo-chiaro" href="/menu">Guarda il menu</a>
      </div>
    </div>
  </section>

  <!-- Informazioni pratiche -->
  <section class="pratiche" aria-label="Informazioni pratiche">
    <div class="contenitore pratiche-griglia">
      <div class="pratica">
        <Icona nome="orologio" />
        <div>
          <h2>Orari</h2>
          <p data-stato class="pratica-stato"><span data-stato-testo>Aperti da martedì a domenica</span></p>
          <p>Oggi: <span data-oggi-orario>{orarioGiorno(new Date().getDay())}</span></p>
          <a class="link-freccia" href="#titolo-orari">Tutti gli orari <Icona nome="freccia" /></a>
        </div>
      </div>
      <div class="pratica">
        <Icona nome="pin" />
        <div>
          <h2>Indirizzo</h2>
          <p>{indirizzoCompleto}</p>
          <a class="link-freccia" href={mapsDirections} target="_blank" rel="noopener">Indicazioni stradali <Icona nome="freccia" /></a>
        </div>
      </div>
      <div class="pratica">
        <Icona nome="telefono" />
        <div>
          <h2>Prenotazioni</h2>
          <p><a class="pratica-tel" href={`tel:${locale.telefonoLink}`}>{locale.telefono}</a></p>
          <a class="link-freccia" href="/prenota">Prenota online <Icona nome="freccia" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Il locale -->
  <section class="sezione">
    <div class="contenitore due-colonne">
      <div class="testo-corrente">
        <h2 class="titolo-sezione">Benvenuti all’Arca di Noè</h2>
        <p class="lead">
          Un locale di famiglia sulla collina di Trenta, a pochi minuti da Cosenza, dove si viene per una pizza tra amici,
          una cena con i parenti o una festa importante.
        </p>
        <p>
          Nella stessa serata si può scegliere tra la pizzeria con il forno a legna, la cucina con i piatti della
          tradizione calabrese e la griglia per carne e pesce. Così ognuno al tavolo trova quello che preferisce.
        </p>
        <p>
          D’estate si cena in veranda o in giardino, con la vista che arriva fino alla città e alla Catena Costiera;
          d’inverno nelle sale interne, climatizzate e accessibili. All’ingresso c’è un ampio parcheggio privato.
        </p>
      </div>
      <figure class="foto-colonna">
        <Image src={fotoCosenza} alt="Cosenza vista dall’alto al tramonto" widths={[600, 900, 1300]} sizes="(max-width: 900px) 100vw, 50vw" quality={72} />
        <figcaption>La valle di Cosenza al tramonto</figcaption>
      </figure>
    </div>
  </section>

  <!-- La cucina -->
  <section class="sezione sezione-alt">
    <div class="contenitore">
      <div class="intestazione-sezione">
        <h2 class="titolo-sezione">La nostra cucina</h2>
        <p class="lead">Tre cucine nello stesso menu, con ingredienti del territorio e porzioni generose.</p>
      </div>
      <div class="cucine">
        {cucine.map((c) => (
          <article class="cucina">
            <Image src={c.foto} alt={c.alt} widths={[400, 700]} sizes="(max-width: 800px) 100vw, 33vw" quality={72} />
            <h3>{c.titolo}</h3>
            <p>{c.testo}</p>
            <a class="link-freccia" href={c.link}>Vedi nel menu <Icona nome="freccia" /></a>
          </article>
        ))}
      </div>
      <div class="centro">
        <a class="btn btn-bordo" href="/menu">Il menu completo</a>
      </div>
    </div>
  </section>

  <!-- Sale ed eventi -->
  <section class="sezione">
    <div class="contenitore due-colonne allinea-alto">
      <div class="testo-corrente">
        <h2 class="titolo-sezione">Spazio per ogni occasione</h2>
        <p class="lead">
          Le sale dell’Arca di Noè accolgono comodamente i grandi gruppi: comunioni, battesimi, compleanni, lauree e cene
          aziendali.
        </p>
        <p>
          Per le feste prepariamo un menu su misura insieme a voi, con pizza, cucina calabrese, griglia o un po’ di tutto.
          In alcune serate c’è anche la musica dal vivo.
        </p>
        <a class="btn btn-pieno" href="/eventi">Organizza un evento</a>
      </div>
      <dl class="spazi">
        {spazi.map((s) => (
          <div>
            <dt>{s.titolo}</dt>
            <dd>{s.testo}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Orari e dove siamo -->
  <section class="sezione sezione-alt" aria-labelledby="titolo-orari">
    <div class="contenitore due-colonne allinea-alto">
      <div>
        <h2 id="titolo-orari" class="titolo-sezione">Orari di apertura</h2>
        <dl class="orari orari-home">
          {giorni.map((g) => (
            <div data-giorno={g}>
              <dt>{locale.orari.find((o) => o.giorno === g)!.nome}</dt>
              <dd>{orarioGiorno(g)}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div>
        <h2 class="titolo-sezione">Come arrivare</h2>
        <p class="indirizzo">{indirizzoCompleto}</p>
        <p class="lead">
          Da Cosenza si sale verso la Sila in direzione Casali del Manco: in pochi minuti si arriva a Trenta. Il parcheggio
          è all’ingresso del locale.
        </p>
        <div class="azioni">
          <a class="btn btn-pieno" href={mapsDirections} target="_blank" rel="noopener"><Icona nome="pin" /> Apri in Google Maps</a>
          <a class="btn btn-bordo" href={`tel:${locale.telefonoLink}`}><Icona nome="telefono" /> Chiama</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Apertura ---------- */
  .apertura {
    position: relative;
    min-height: min(88svh, 820px);
    display: flex;
    align-items: flex-end;
    color: #fff;
    overflow: hidden;
  }
  .apertura :global(.apertura-foto) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 60%;
  }
  .apertura-velo {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(20, 16, 12, 0.55) 0%, rgba(20, 16, 12, 0) 28%),
      linear-gradient(0deg, rgba(20, 16, 12, 0.78) 0%, rgba(20, 16, 12, 0.25) 55%, rgba(20, 16, 12, 0.1) 100%);
  }
  .apertura-testo {
    position: relative;
    padding-top: 140px;
    padding-bottom: clamp(48px, 8vw, 96px);
  }
  .apertura h1 {
    font-size: clamp(2.3rem, 5.4vw, 4.2rem);
    max-width: 17ch;
    line-height: 1.08;
  }
  .apertura-testo > p {
    margin-top: 1.1rem;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    max-width: 52ch;
    color: rgba(255, 255, 255, 0.9);
  }
  .apertura-azioni {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  @media (max-width: 560px) {
    .apertura-azioni .btn {
      flex: 1 1 100%;
    }
  }

  /* ---------- Informazioni pratiche ---------- */
  .pratiche {
    border-bottom: 1px solid var(--linea);
  }
  .pratiche-griglia {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .pratica {
    display: flex;
    gap: 1rem;
    padding: clamp(1.75rem, 3vw, 2.5rem) clamp(1rem, 2.5vw, 2rem);
    border-left: 1px solid var(--linea);
  }
  .pratica:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .pratica > :global(svg) {
    width: 22px;
    height: 22px;
    flex: none;
    margin-top: 0.2rem;
    color: var(--accento);
  }
  .pratica h2 {
    font-family: var(--sans);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }
  .pratica p {
    color: var(--ink-2);
  }
  .pratica-stato {
    font-weight: 600;
  }
  .pratica-stato[data-aperto='true'] {
    color: var(--aperto);
  }
  .pratica-tel {
    font-family: var(--serif);
    font-size: 1.5rem;
    color: var(--ink);
    text-decoration: none;
  }
  .pratica .link-freccia {
    margin-top: 0.2rem;
  }
  @media (max-width: 860px) {
    .pratiche-griglia {
      grid-template-columns: 1fr;
    }
    .pratica {
      border-left: 0;
      border-top: 1px solid var(--linea);
      padding-inline: 0;
    }
    .pratica:first-child {
      border-top: 0;
    }
  }

  /* ---------- Layout comuni ---------- */
  .due-colonne {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: center;
  }
  .allinea-alto {
    align-items: start;
  }
  @media (max-width: 900px) {
    .due-colonne {
      grid-template-columns: 1fr;
    }
  }
  .testo-corrente .titolo-sezione {
    margin-bottom: 1.2rem;
  }
  .testo-corrente .lead {
    margin-bottom: 1.2rem;
  }
  .testo-corrente .btn {
    margin-top: 2rem;
  }
  .foto-colonna {
    margin: 0;
  }
  .foto-colonna :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .foto-colonna figcaption {
    margin-top: 0.6rem;
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .intestazione-sezione {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  /* ---------- Cucina ---------- */
  .cucine {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .cucina :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .cucina h3 {
    font-size: 1.6rem;
    margin-top: 1.3rem;
  }
  .cucina p {
    margin-top: 0.6rem;
    color: var(--ink-2);
  }
  .cucina .link-freccia {
    margin-top: 0.5rem;
  }
  .centro {
    display: flex;
    justify-content: center;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  @media (max-width: 800px) {
    .cucine {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  /* ---------- Spazi ---------- */
  .spazi {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 2.5rem;
    padding-top: 0.6rem;
  }
  .spazi div {
    padding-top: 1.2rem;
    border-top: 1px solid var(--ink);
  }
  .spazi dt {
    font-family: var(--serif);
    font-size: 1.3rem;
  }
  .spazi dd {
    margin: 0.4rem 0 0;
    color: var(--ink-2);
  }
  @media (max-width: 520px) {
    .spazi {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Orari e strada ---------- */
  .orari-home {
    margin-top: 1.6rem;
    max-width: 440px;
  }
  .indirizzo {
    margin: 1.6rem 0 0.8rem;
    font-family: var(--serif);
    font-size: 1.35rem;
    line-height: 1.35;
  }
  .azioni {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.8rem;
  }
</style>
