---
import Base from '../layouts/Base.astro';

const foto = [
  { titolo: 'Cosenza al tramonto', autore: 'Ric64 Rinaldo Panucci', licenza: 'CC BY-SA 4.0', licenzaUrl: 'https://creativecommons.org/licenses/by-sa/4.0/', fonte: 'https://commons.wikimedia.org/wiki/File:Cosenza-panorama-da-portapiana-al-tramonto.jpg' },
  { titolo: 'Pizza nel forno a legna', autore: 'oakwoodfirepizza.com', licenza: 'CC BY-SA 4.0', licenzaUrl: 'https://creativecommons.org/licenses/by-sa/4.0/', fonte: 'https://commons.wikimedia.org/wiki/File:Wood_Oven_Pizza.jpg' },
  { titolo: 'Pizza margherita', autore: 'Bex Walton', licenza: 'CC BY 2.0', licenzaUrl: 'https://creativecommons.org/licenses/by/2.0/', fonte: 'https://commons.wikimedia.org/wiki/File:Neapolitan_pizza_at_Trappica_(48701940197).jpg' },
  { titolo: 'Pappardelle ai porcini', autore: 'Anna.Massini', licenza: 'CC BY 4.0', licenzaUrl: 'https://creativecommons.org/licenses/by/4.0/', fonte: 'https://commons.wikimedia.org/wiki/File:Pappardelle_con_funghi_porcini.jpg' },
  { titolo: 'Grigliata di pesce', autore: 'Gordito1869', licenza: 'CC BY-SA 4.0', licenzaUrl: 'https://creativecommons.org/licenses/by-sa/4.0/', fonte: 'https://commons.wikimedia.org/wiki/File:Parrillada_de_Pescado.jpg' },
  { titolo: 'Salsicce sulla brace', autore: 'Santeri Viinamäki', licenza: 'CC BY-SA 4.0', licenzaUrl: 'https://creativecommons.org/licenses/by-sa/4.0/', fonte: 'https://commons.wikimedia.org/wiki/File:Grilling_sausages.jpg' },
  { titolo: 'Tiramisù', autore: 'Raffaele Diomede', licenza: 'CC BY 2.0', licenzaUrl: 'https://creativecommons.org/licenses/by/2.0/', fonte: 'https://commons.wikimedia.org/wiki/File:Tiramisu_-_Raffaele_Diomede.jpg' },
];
---
<Base titolo="Crediti foto">
  <div class="contenitore testo">
    <h1>Crediti foto</h1>
    <p class="lead">Le foto del sito provengono da Wikimedia Commons e sono usate secondo le rispettive licenze. Sono state ritagliate e ridimensionate.</p>
    <ul>
      {foto.map((f) => (
        <li>
          <strong>{f.titolo}</strong>: <a href={f.fonte} target="_blank" rel="noopener">{f.autore}</a>,{' '}
          <a href={f.licenzaUrl} target="_blank" rel="noopener">{f.licenza}</a>
        </li>
      ))}
    </ul>
    <p>Caratteri: Bricolage Grotesque e Atkinson Hyperlegible, SIL Open Font License.</p>
  </div>
</Base>

<style>
  .testo {
    max-width: 820px;
    padding-block: clamp(48px, 8vw, 110px);
  }
  h1 {
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    margin-bottom: 1.2rem;
  }
  ul {
    margin: 2rem 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.7rem;
    color: var(--ink-2);
  }
  strong {
    color: var(--ink);
  }
  p:last-child {
    color: var(--ink-3);
  }
</style>
