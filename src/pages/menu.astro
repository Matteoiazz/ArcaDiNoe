---
import Base from '../layouts/Base.astro';
import Icona from '../components/Icona.astro';
import { locale } from '../data/locale';
import { menu, etichette, euro } from '../data/menu';
---
<Base
  titolo="Menu"
  descrizione="Il menu dell’Arca di Noè a Trenta (CS): pizze nel forno a legna, antipasti, primi della tradizione calabrese, grigliate di carne e pesce, dolci. Opzioni vegetariane e senza glutine."
>
  <header class="testa">
    <div class="contenitore">
      <h1>Il <em>menu</em></h1>
      <p class="lead">
        Pizze dal forno a legna, cucina calabrese e griglia. Per allergie e intolleranze chiedete pure al personale: vi
        indicheremo i piatti adatti.
      </p>
      {locale.anteprima && <p class="avviso">Menu dimostrativo: piatti e prezzi sono indicativi.</p>}
    </div>
  </header>

  <div class="strumenti">
    <div class="contenitore strumenti-riga">
      <nav class="categorie" aria-label="Categorie del menu">
        {menu.map((c) => <a href={`#${c.id}`} data-cat-link={c.id}>{c.nome}</a>)}
      </nav>
      <div class="filtri">
        <label class="cerca">
          <Icona nome="cerca" />
          <span class="sr-only">Cerca nel menu</span>
          <input type="search" placeholder="Cerca un piatto" data-cerca autocomplete="off" />
        </label>
        <button type="button" class="filtro" aria-pressed="false" data-filtro="v">Vegetariano</button>
        <button type="button" class="filtro" aria-pressed="false" data-filtro="gf">Senza glutine</button>
      </div>
    </div>
  </div>

  <div class="contenitore corpo">
    <div class="griglia">
      {menu.map((c) => (
        <section class="categoria" id={c.id} data-categoria aria-labelledby={`t-${c.id}`}>
          <h2 id={`t-${c.id}`}>{c.nome}</h2>
          {c.nota && <p class="nota">{c.nota}</p>}
          <ul class="piatti">
            {c.piatti.map((p) => (
              <li class="piatto" data-piatto data-tag={(p.etichette ?? []).join(' ')} data-testo={`${p.nome} ${p.descrizione ?? ''}`.toLowerCase()}>
                <div class="piatto-riga">
                  <h3>
                    {p.nome}
                    {p.etichette?.map((e) => (
                      <abbr class:list={['tag', `tag-${e}`]} title={etichette[e].lungo}>{etichette[e].breve}</abbr>
                    ))}
                  </h3>
                  <span class="prezzo"><span class="sr-only">Prezzo: </span>€ {euro(p.prezzo)}</span>
                </div>
                {p.descrizione && <p class="descrizione">{p.descrizione}</p>}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <div class="vuoto" data-vuoto hidden>
      <p>Nessun piatto corrisponde alla ricerca.</p>
      <button type="button" class="btn btn-bordo" data-reset>Mostra tutto il menu</button>
    </div>

    <aside class="legenda" aria-label="Legenda">
      {Object.entries(etichette).map(([k, v]) => (
        <span><abbr class:list={['tag', `tag-${k}`]}>{v.breve}</abbr> {v.lungo}</span>
      ))}
      <span>Coperto, allergeni e disponibilità: chiedere al personale.</span>
    </aside>

    <div class="cta">
      <div>
        <h2>Vi aspettiamo a tavola</h2>
        <p>Prenotate online o chiamate. Le pizze si possono ordinare anche da asporto.</p>
      </div>
      <div class="cta-azioni">
        <a class="btn btn-pieno" href="/prenota">Prenota un tavolo</a>
        <a class="btn btn-bordo" href={`tel:${locale.telefonoLink}`}><Icona nome="telefono" /> {locale.telefono}</a>
      </div>
    </div>
  </div>
</Base>

<script>
  const cerca = document.querySelector<HTMLInputElement>('[data-cerca]')!;
  const filtri = [...document.querySelectorAll<HTMLButtonElement>('[data-filtro]')];
  const piatti = [...document.querySelectorAll<HTMLElement>('[data-piatto]')];
  const categorie = [...document.querySelectorAll<HTMLElement>('[data-categoria]')];
  const vuoto = document.querySelector<HTMLElement>('[data-vuoto]')!;

  const normalizza = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[’']/g, ' ').toLowerCase();

  function applica() {
    const q = normalizza(cerca.value.trim());
    const attivi = filtri.filter((f) => f.getAttribute('aria-pressed') === 'true').map((f) => f.dataset.filtro!);
    let totale = 0;
    for (const p of piatti) {
      const tag = (p.dataset.tag ?? '').split(' ');
      const ok = (!q || normalizza(p.dataset.testo ?? '').includes(q)) && attivi.every((a) => tag.includes(a));
      p.hidden = !ok;
      if (ok) totale++;
    }
    for (const c of categorie) c.hidden = !c.querySelector('[data-piatto]:not([hidden])');
    vuoto.hidden = totale > 0;
  }

  cerca.addEventListener('input', applica);
  filtri.forEach((f) =>
    f.addEventListener('click', () => {
      f.setAttribute('aria-pressed', String(f.getAttribute('aria-pressed') !== 'true'));
      applica();
    }),
  );
  document.querySelector('[data-reset]')?.addEventListener('click', () => {
    cerca.value = '';
    filtri.forEach((f) => f.setAttribute('aria-pressed', 'false'));
    applica();
  });

  // Categoria attiva mentre si scorre
  const link = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-cat-link]')].map((a) => [a.dataset.catLink!, a]));
  const osserva = new IntersectionObserver(
    (voci) => {
      for (const v of voci) {
        if (!v.isIntersecting) continue;
        link.forEach((a) => a.removeAttribute('aria-current'));
        const a = link.get(v.target.id);
        if (a) {
          a.setAttribute('aria-current', 'true');
          a.parentElement!.scrollTo({ left: a.offsetLeft - 20, behavior: 'smooth' });
        }
      }
    },
    { rootMargin: '-30% 0px -65% 0px' },
  );
  categorie.forEach((c) => osserva.observe(c));
</script>

<style>
  .testa {
    padding-block: clamp(48px, 7vw, 88px) clamp(32px, 4vw, 48px);
    text-align: center;
  }
  .testa h1 {
    font-size: clamp(3.4rem, 9vw, 7rem);
    line-height: 0.95;
    margin-bottom: 1rem;
  }
  .testa .lead {
    margin-inline: auto;
  }
  .avviso {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: #8a6a12;
  }

  .strumenti {
    position: sticky;
    top: 80px;
    z-index: 40;
    background: #fff;
    border-block: 1px solid var(--linea);
  }
  @media (max-width: 900px) {
    /* Su telefono la barra non resta fissa: lascerebbe troppo poco spazio ai piatti */
    .strumenti {
      position: static;
    }
    .griglia .categoria {
      scroll-margin-top: 90px;
    }
  }
  .strumenti-riga {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.6rem;
  }
  .categorie {
    display: flex;
    gap: 0.2rem;
    overflow-x: auto;
    scrollbar-width: none;
    flex: 1;
    min-width: 0;
  }
  .categorie::-webkit-scrollbar {
    display: none;
  }
  .categorie a {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 0.8rem;
    border-radius: var(--raggio);
    text-decoration: none;
    font-weight: 500;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .categorie a:hover {
    color: var(--ink);
    background: var(--bg-alt);
  }
  .categorie a[aria-current] {
    color: #fff;
    background: var(--accento);
  }
  .filtri {
    display: flex;
    gap: 0.5rem;
    flex: none;
  }
  .cerca {
    position: relative;
  }
  .cerca :global(svg) {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    width: 17px;
    translate: 0 -50%;
    color: var(--ink-3);
    pointer-events: none;
  }
  .cerca input {
    min-height: 42px;
    width: 210px;
    padding-left: 2.3rem;
  }
  .filtro {
    min-height: 42px;
    padding: 0 0.9rem;
    border-radius: var(--raggio);
    border: 1px solid #cfc8bc;
    background: #fff;
    color: var(--ink-2);
    font: inherit;
    font-size: 0.925rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .filtro:hover {
    border-color: var(--ink-3);
    color: var(--ink);
  }
  .filtro[aria-pressed='true'] {
    border-color: var(--accento);
    background: var(--accento);
    color: #fff;
  }
  @media (max-width: 900px) {
    .strumenti-riga {
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
    }
    .filtri {
      flex-wrap: wrap;
    }
    .cerca {
      flex: 1 1 100%;
    }
    .cerca input {
      width: 100%;
    }
    .filtro {
      flex: 1;
    }
  }

  .corpo {
    padding-block: clamp(40px, 6vw, 72px) clamp(64px, 9vw, 112px);
  }
  .griglia {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(3rem, 5vw, 4.5rem) clamp(3rem, 7vw, 6rem);
    align-items: start;
  }
  @media (max-width: 860px) {
    .griglia {
      grid-template-columns: 1fr;
    }
  }
  .categoria {
    scroll-margin-top: 170px;
  }
  .categoria h2 {
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    font-style: italic;
    color: var(--accento);
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--ink);
  }
  .nota {
    margin-top: 0.8rem;
    color: var(--ink-3);
    font-size: 0.95rem;
  }
  .piatti {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .piatto {
    padding-block: 1rem;
    border-bottom: 1px solid var(--linea);
  }
  .piatto-riga {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .piatto h3 {
    font-family: var(--sans);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0;
  }
  .prezzo {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .descrizione {
    margin-top: 0.2rem;
    color: var(--ink-2);
    font-size: 0.95rem;
    max-width: 48ch;
  }
  .tag {
    display: inline-grid;
    place-items: center;
    min-width: 1.5rem;
    height: 1.25rem;
    margin-left: 0.4rem;
    padding: 0 0.25rem;
    border-radius: 3px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    vertical-align: 0.12em;
    border: 1px solid currentColor;
    cursor: help;
  }
  .tag-v {
    color: var(--aperto);
  }
  .tag-gf {
    color: #8a6a12;
  }
  .tag-hot {
    color: #b3261e;
  }

  .vuoto {
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding-block: 3rem;
    color: var(--ink-2);
  }

  .legenda {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    margin-top: clamp(3rem, 5vw, 4rem);
    color: var(--ink-3);
    font-size: 0.9rem;
  }
  .legenda .tag {
    margin: 0 0.3rem 0 0;
  }

  .cta {
    border-radius: var(--raggio-foto);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem 2rem;
    margin-top: clamp(3rem, 5vw, 4rem);
    padding: clamp(1.75rem, 3vw, 2.5rem);
    background: var(--bg-alt);
  }
  .cta h2 {
    font-size: 2.4rem;
  }
  .cta p {
    margin-top: 0.4rem;
    color: var(--ink-2);
  }
  .cta-azioni {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
