---
import Base from '../layouts/Base.astro';
import Icona from '../components/Icona.astro';
import { locale, indirizzoCompleto, mapsDirections, appleMapsLink, mapsEmbed } from '../data/locale';
import { orarioGiorno } from '../lib/orari';

const giorni = [1, 2, 3, 4, 5, 6, 0];
---
<Base titolo="Dove siamo" descrizione={`L’Arca di Noè: ${indirizzoCompleto}. Indicazioni stradali, orari e parcheggio privato. Telefono ${locale.telefono}.`}>
  <div class="contenitore pagina">
    <div>
      <h1>Dove siamo</h1>
      <p class="indirizzo">{indirizzoCompleto}</p>
      <p class="lead">
        Siamo sulla collina di Trenta, nel comune di Casali del Manco, a pochi minuti da Cosenza salendo verso la Sila.
        All’ingresso trovate un ampio parcheggio privato.
      </p>

      <div class="azioni">
        <a class="btn btn-pieno" href={mapsDirections} target="_blank" rel="noopener"><Icona nome="pin" /> Google Maps</a>
        <a class="btn btn-bordo" href={appleMapsLink} target="_blank" rel="noopener">Mappe Apple</a>
      </div>

      <div class="blocchi">
        <div>
          <h2>Contatti</h2>
          <p>Telefono: <a href={`tel:${locale.telefonoLink}`}>{locale.telefono}</a></p>
          <p>Prenotazioni anche <a href="/prenota">online</a>.</p>
        </div>
        <div>
          <h2>Orari</h2>
          <dl class="orari">
            {giorni.map((g) => (
              <div data-giorno={g}>
                <dt>{locale.orari.find((o) => o.giorno === g)!.nome}</dt>
                <dd>{orarioGiorno(g)}</dd>
              </div>
            ))}
          </dl>
        </div>
        <div>
          <h2>Servizi</h2>
          <ul class="servizi">
            {locale.servizi.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      </div>
    </div>

    <div class="mappa" data-mappa>
      <div class="mappa-copertina">
        <Icona nome="pin" class="mappa-pin" />
        <p>La mappa è fornita da Google. Caricandola, Google può raccogliere dati sulla navigazione.</p>
        <button class="btn btn-pieno" type="button" data-mappa-carica>Mostra la mappa</button>
        <a href={mapsDirections} target="_blank" rel="noopener">Oppure apri Google Maps</a>
      </div>
    </div>
  </div>
</Base>

<script define:vars={{ mapsEmbed }}>
  document.querySelector('[data-mappa-carica]')?.addEventListener('click', () => {
    const box = document.querySelector('[data-mappa]');
    const f = document.createElement('iframe');
    f.src = mapsEmbed;
    f.title = 'Mappa: posizione dell’Arca di Noè';
    f.loading = 'lazy';
    f.referrerPolicy = 'no-referrer-when-downgrade';
    box.replaceChildren(f);
  });
</script>

<style>
  .pagina {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    padding-block: clamp(48px, 7vw, 88px) clamp(64px, 9vw, 112px);
    align-items: start;
  }
  @media (max-width: 900px) {
    .pagina {
      grid-template-columns: 1fr;
    }
  }
  h1 {
    font-size: clamp(2.4rem, 5vw, 3.4rem);
  }
  .indirizzo {
    margin: 1rem 0 0.8rem;
    font-family: var(--serif);
    font-size: 1.4rem;
    line-height: 1.35;
  }
  .azioni {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.8rem;
  }
  .blocchi {
    display: grid;
    gap: 2.4rem;
    margin-top: 3rem;
  }
  .blocchi h2 {
    font-family: var(--sans);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
  }
  .blocchi p {
    color: var(--ink-2);
  }
  .blocchi .orari {
    max-width: 420px;
  }
  .servizi {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--ink-2);
    columns: 2;
    column-gap: 2rem;
  }
  .servizi li {
    margin-bottom: 0.35rem;
    break-inside: avoid;
  }
  @media (max-width: 520px) {
    .servizi {
      columns: 1;
    }
  }

  .mappa {
    position: sticky;
    top: 110px;
    aspect-ratio: 4 / 5;
    background: var(--bg-alt);
    overflow: hidden;
  }
  .mappa :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .mappa-copertina {
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1rem;
    padding: 2rem;
    text-align: center;
    color: var(--ink-2);
  }
  .mappa-copertina p {
    max-width: 34ch;
    font-size: 0.95rem;
  }
  .mappa-copertina a {
    font-size: 0.95rem;
  }
  .mappa-copertina :global(.mappa-pin) {
    width: 40px;
    height: 40px;
    color: var(--accento);
  }
  @media (max-width: 900px) {
    .mappa {
      position: static;
      aspect-ratio: 1;
    }
  }
</style>
