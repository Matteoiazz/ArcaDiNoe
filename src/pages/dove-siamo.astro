---
import Base from '../layouts/Base.astro';
import Icona from '../components/Icona.astro';
import { locale, indirizzoCompleto, mapsDirections, appleMapsLink, mapsEmbed } from '../data/locale';
import { orarioGiorno } from '../lib/orari';

const giorni = [1, 2, 3, 4, 5, 6, 0];
---
<Base titolo="Dove siamo" descrizione={`L’Arca di Noè: ${indirizzoCompleto}. Indicazioni stradali, orari e parcheggio privato. Telefono ${locale.telefono}.`}>
  <div class="contenitore pagina">
    <div class="info">
      <h1 class="titolo">Dove siamo</h1>
      <p class="indirizzo">{indirizzoCompleto}</p>
      <p class="lead">Sulla collina di Trenta, verso la Sila, a pochi minuti da Cosenza. All’ingresso trovi un ampio parcheggio privato.</p>

      <div class="azioni">
        <a class="btn btn-luce" href={mapsDirections} target="_blank" rel="noopener"><Icona nome="pin" /> Google Maps</a>
        <a class="btn btn-linea" href={appleMapsLink} target="_blank" rel="noopener">Mappe Apple</a>
        <a class="btn btn-linea" href={`tel:${locale.telefonoLink}`}><Icona nome="telefono" /> {locale.telefono}</a>
      </div>

      <h2 class="sotto">Orari</h2>
      <dl class="orari">
        {giorni.map((g) => (
          <div data-giorno={g}>
            <dt>{locale.orari.find((o) => o.giorno === g)!.nome}</dt>
            <dd>{orarioGiorno(g)}</dd>
          </div>
        ))}
      </dl>

      <h2 class="sotto">Servizi</h2>
      <ul class="servizi">
        {locale.servizi.map((s) => <li>{s}</li>)}
      </ul>
    </div>

    <div class="mappa" data-mappa>
      <div class="mappa-copertina" data-mappa-copertina>
        <Icona nome="pin" class="mappa-pin" />
        <p>La mappa è fornita da Google. Caricandola, Google può raccogliere dati sulla tua navigazione.</p>
        <button class="btn btn-luce" type="button" data-mappa-carica>Mostra la mappa</button>
        <a href={mapsDirections} target="_blank" rel="noopener">Oppure apri Google Maps <Icona nome="esterno" class="ic" /></a>
      </div>
    </div>
  </div>
</Base>

<script define:vars={{ mapsEmbed }}>
  document.querySelector('[data-mappa-carica]')?.addEventListener('click', () => {
    const box = document.querySelector('[data-mappa]');
    const f = document.createElement('iframe');
    f.src = mapsEmbed;
    f.title = 'Mappa: posizione dell’Arca di Noè';
    f.loading = 'lazy';
    f.referrerPolicy = 'no-referrer-when-downgrade';
    box.replaceChildren(f);
  });
</script>

<style>
  .pagina {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-block: clamp(40px, 7vw, 96px) clamp(64px, 9vw, 120px);
    align-items: start;
  }
  @media (max-width: 900px) {
    .pagina {
      grid-template-columns: 1fr;
    }
  }
  .titolo {
    font-size: clamp(2.8rem, 8vw, 5.5rem);
    font-weight: 800;
    font-stretch: 76%;
    line-height: 0.9;
  }
  .indirizzo {
    margin: 1.2rem 0 0.8rem;
    font-family: var(--display);
    font-weight: 700;
    font-stretch: 88%;
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    line-height: 1.2;
    color: var(--luce);
  }
  .azioni {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.8rem;
  }
  .sotto {
    margin-top: 3rem;
    font-size: 1.6rem;
  }
  .orari {
    margin: 1rem 0 0;
    display: grid;
    gap: 0.4rem;
    max-width: 420px;
    font-variant-numeric: tabular-nums;
  }
  .orari div {
    display: flex;
    justify-content: space-between;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--notte-3);
    color: var(--carta-2);
  }
  .orari dd {
    margin: 0;
  }
  .orari div[data-oggi] {
    color: var(--luce-forte);
    font-weight: 700;
  }
  .servizi {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .servizi li {
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--notte-4);
    color: var(--carta-2);
    font-size: 0.95rem;
  }

  .mappa {
    position: sticky;
    top: 100px;
    aspect-ratio: 4 / 5;
    border-radius: var(--raggio);
    overflow: hidden;
    background:
      radial-gradient(60% 50% at 50% 45%, rgba(244, 197, 106, 0.18), transparent 70%),
      var(--notte-2);
  }
  .mappa :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    filter: invert(0.9) hue-rotate(180deg) saturate(0.7) brightness(0.95);
  }
  .mappa-copertina {
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.1rem;
    padding: 2rem;
    text-align: center;
    color: var(--carta-2);
  }
  .mappa-copertina p {
    max-width: 36ch;
    font-size: 0.95rem;
  }
  .mappa-copertina a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.95rem;
  }
  .mappa-copertina :global(.ic) {
    width: 16px;
  }
  .mappa-copertina :global(.mappa-pin) {
    width: 56px;
    height: 56px;
    color: var(--luce);
  }
  @media (max-width: 900px) {
    .mappa {
      position: static;
      aspect-ratio: 1;
    }
  }
</style>
