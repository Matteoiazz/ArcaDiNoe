---
/** Il segno dell'Arca: scafo, cabina e una finestra accesa. */
interface Props {
  class?: string;
  titolo?: string;
}
const { class: cls, titolo } = Astro.props;
---
<svg class={cls} viewBox="0 0 48 32" role={titolo ? 'img' : undefined} aria-hidden={titolo ? undefined : 'true'} aria-label={titolo}>
  <path d="M2 17h44l-5.2 9.6A4 4 0 0 1 37.3 29H10.7a4 4 0 0 1-3.5-2.4L2 17Z" fill="currentColor" />
  <path d="M13 17V10.5L24 4l11 6.5V17Z" fill="currentColor" opacity=".72" />
  <rect x="21.2" y="10.4" width="5.6" height="4.6" rx=".8" fill="var(--luce)" />
</svg>
