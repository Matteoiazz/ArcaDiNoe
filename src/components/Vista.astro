---
/**
 * La vista: cielo, Catena Costiera, le luci di Cosenza nella valle e,
 * sul crinale vicino, l'Arca con il giardino illuminato.
 * Disegnato su canvas; l'insegna del locale è accesa solo quando il locale è aperto.
 */
---
<div class="vista" aria-hidden="true">
  <canvas class="vista-canvas"></canvas>
</div>

<script>
  import { stato, adessoRoma } from '../lib/orari';

  type Luce = { x: number; y: number; r: number; a: number; f: number; p: number; c: number };

  const canvas = document.querySelector<HTMLCanvasElement>('.vista-canvas');
  if (canvas) avvia(canvas);

  function avvia(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d')!;
    const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // RNG deterministico: la scena è sempre la stessa.
    let seme = 20240917;
    const rnd = () => ((seme = (seme * 1664525 + 1013904223) >>> 0) / 4294967296);
    const gauss = () => {
      let u = 0;
      for (let i = 0; i < 4; i++) u += rnd();
      return u / 2 - 1;
    };

    // Profili dei rilievi in coordinate normalizzate.
    const crinaleLontano = (x: number) =>
      0.585 - 0.05 * Math.sin(x * 2.6 + 0.6) - 0.025 * Math.sin(x * 7.3 + 1.7) - 0.012 * Math.sin(x * 17 + 0.3) - 0.03 * Math.exp(-((x - 0.2) ** 2) / 0.02);
    const crinaleVicino = (x: number) =>
      0.86 - 0.14 * Math.pow(Math.max(0, x - 0.35) / 0.65, 1.3) - 0.012 * Math.sin(x * 9 + 2) - 0.006 * Math.sin(x * 23);

    // Stelle
    const stelle = Array.from({ length: 140 }, () => ({ x: rnd(), y: rnd() * 0.5, r: rnd() * 0.9 + 0.3, a: rnd() * 0.5 + 0.15, p: rnd() * 6.28 }));

    // Luci di Cosenza e dei paesi
    const luci: Luce[] = [];
    const caldi = ['#ffd98a', '#f4c56a', '#ffe7b8', '#f2b25c', '#fff3d6'];
    for (let i = 0; i < 1500; i++) {
      const x = 0.42 + gauss() * 0.34;
      const y = 0.69 + gauss() * 0.05 + (x - 0.42) * 0.03;
      if (x < 0 || x > 1) continue;
      const fondo = crinaleLontano(x) + 0.03;
      if (y < fondo) continue;
      luci.push({ x, y, r: rnd() < 0.12 ? rnd() * 1.1 + 1.2 : rnd() * 0.9 + 0.55, a: rnd() * 0.55 + 0.35, f: rnd() < 0.3 ? rnd() * 2 + 0.6 : 0, p: rnd() * 6.28, c: Math.floor(rnd() * caldi.length) });
    }
    // Paesi sparsi sulle pendici lontane
    for (let k = 0; k < 9; k++) {
      const cx = rnd();
      const cy = crinaleLontano(cx) + 0.012 + rnd() * 0.03;
      const n = 6 + Math.floor(rnd() * 18);
      for (let i = 0; i < n; i++) {
        luci.push({ x: cx + gauss() * 0.012, y: cy + gauss() * 0.006, r: rnd() * 0.6 + 0.35, a: rnd() * 0.4 + 0.3, f: rnd() < 0.4 ? rnd() * 2 + 0.5 : 0, p: rnd() * 6.28, c: Math.floor(rnd() * caldi.length) });
      }
    }

    // Strade con auto in movimento
    const strade = [
      (t: number) => ({ x: t, y: 0.735 + 0.02 * Math.sin(t * 5 + 1) + (t - 0.5) * 0.02 }),
      (t: number) => ({ x: 0.15 + t * 0.6, y: 0.665 + 0.012 * Math.sin(t * 9) + t * 0.05 }),
    ];
    const auto = Array.from({ length: 16 }, (_, i) => ({ s: i % 2, t: rnd(), v: (rnd() * 0.012 + 0.006) * (rnd() < 0.5 ? 1 : -1) }));

    // Alberi sul crinale vicino
    const alberi = Array.from({ length: 46 }, () => {
      const x = rnd();
      return { x, r: rnd() * 0.012 + 0.008, h: rnd() * 0.02 + 0.006 };
    }).filter((a) => a.x < 0.66 || a.x > 0.9);

    let W = 0, H = 0, dpr = 1, scrollY = 0, aperto = stato().aperto, accensione = 0, visibile = true, raf = 0;

    function dimensiona() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const r = canvas.getBoundingClientRect();
      W = r.width;
      H = r.height;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function cielo() {
      const ora = adessoRoma().minuti / 60;
      // Imbrunire tra le 17 e le 20, poi notte piena.
      const imbrunire = ora >= 17 && ora < 20 ? 1 - Math.abs(ora - 18.5) / 1.5 : ora >= 7 && ora < 17 ? 0.85 : 0;
      const g = ctx.createLinearGradient(0, 0, 0, H * 0.7);
      g.addColorStop(0, mescola('#060c18', '#13223f', imbrunire));
      g.addColorStop(0.6, mescola('#0e1a2f', '#3a4a72', imbrunire));
      g.addColorStop(1, mescola('#1b2c48', '#8a6f86', imbrunire));
      return { g, imbrunire };
    }

    function mescola(a: string, b: string, t: number) {
      const pa = [1, 3, 5].map((i) => parseInt(a.slice(i, i + 2), 16));
      const pb = [1, 3, 5].map((i) => parseInt(b.slice(i, i + 2), 16));
      return `rgb(${pa.map((v, i) => Math.round(v + (pb[i] - v) * t)).join(',')})`;
    }

    function disegna(t: number) {
      const s = scrollY;
      const { g, imbrunire } = cielo();
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, W, H);

      // Stelle (più fioche all'imbrunire)
      const dyS = -s * 0.08;
      for (const st of stelle) {
        const a = st.a * (1 - imbrunire * 0.8) * (ridotto ? 1 : 0.75 + 0.25 * Math.sin(t * 0.0012 + st.p));
        ctx.fillStyle = `rgba(245,238,225,${a})`;
        ctx.beginPath();
        ctx.arc(st.x * W, st.y * H + dyS, st.r, 0, 6.283);
        ctx.fill();
      }

      // Foschia sopra la valle: il riflesso delle luci
      const dyV = -s * 0.22;
      const alone = ctx.createRadialGradient(W * 0.42, H * 0.7 + dyV, 0, W * 0.42, H * 0.7 + dyV, W * 0.55);
      alone.addColorStop(0, 'rgba(244,197,106,0.16)');
      alone.addColorStop(1, 'rgba(244,197,106,0)');
      ctx.fillStyle = alone;
      ctx.fillRect(0, 0, W, H);

      // Catena Costiera
      const dyL = -s * 0.15;
      ctx.fillStyle = '#13213a';
      ctx.beginPath();
      ctx.moveTo(0, H);
      for (let i = 0; i <= 120; i++) {
        const x = i / 120;
        ctx.lineTo(x * W, crinaleLontano(x) * H + dyL);
      }
      ctx.lineTo(W, H);
      ctx.fill();

      // Valle
      const valle = ctx.createLinearGradient(0, H * 0.6 + dyL, 0, H);
      valle.addColorStop(0, 'rgba(14,26,46,0)');
      valle.addColorStop(1, 'rgba(10,18,32,0.9)');
      ctx.fillStyle = valle;
      ctx.fillRect(0, H * 0.6 + dyL, W, H);

      // Luci
      for (const l of luci) {
        const a = l.f && !ridotto ? l.a * (0.65 + 0.35 * Math.sin(t * 0.001 * l.f + l.p)) : l.a;
        if (l.r > 1.2) {
          ctx.globalAlpha = a * 0.22;
          ctx.fillStyle = caldi[l.c];
          ctx.beginPath();
          ctx.arc(l.x * W, l.y * H + dyV, l.r * 3.2, 0, 6.283);
          ctx.fill();
        }
        ctx.globalAlpha = a;
        ctx.fillStyle = caldi[l.c];
        ctx.beginPath();
        ctx.arc(l.x * W, l.y * H + dyV, l.r, 0, 6.283);
        ctx.fill();
      }
      ctx.globalAlpha = 1;

      // Auto lungo le strade
      for (const a of auto) {
        if (!ridotto) a.t = (a.t + a.v * 0.016 + 1) % 1;
        const p = strade[a.s](a.t);
        ctx.fillStyle = a.v > 0 ? 'rgba(255,240,210,0.95)' : 'rgba(255,120,90,0.85)';
        ctx.beginPath();
        ctx.arc(p.x * W, p.y * H + dyV, 1.3, 0, 6.283);
        ctx.fill();
      }

      // Crinale vicino: Trenta
      const dyN = -s * 0.32;
      ctx.fillStyle = '#060c17';
      ctx.beginPath();
      ctx.moveTo(0, H + 2);
      for (let i = 0; i <= 120; i++) {
        const x = i / 120;
        ctx.lineTo(x * W, crinaleVicino(x) * H + dyN);
      }
      ctx.lineTo(W, H + 2);
      ctx.fill();
      ctx.fillRect(0, H - 2, W, Math.max(0, -dyN) + 4);

      // Alberi
      const u = Math.min(W, H * 1.6);
      for (const a of alberi) {
        const by = crinaleVicino(a.x) * H + dyN;
        ctx.beginPath();
        ctx.ellipse(a.x * W, by - a.h * u, a.r * u, (a.r + a.h) * u, 0, 0, 6.283);
        ctx.fill();
      }

      arca(dyN, t, u);
    }

    function arca(dy: number, t: number, u: number) {
      const ax = 0.78;
      const base = crinaleVicino(ax) * H + dy;
      const x = ax * W;
      const k = u / 900; // scala
      const luce = aperto ? accensione : 0;

      // Giardino: filo di luci tra due pali
      const x1 = x - 150 * k, x2 = x + 120 * k, y1 = crinaleVicino(ax - (150 * k) / W) * H + dy - 34 * k;
      const y2 = crinaleVicino(ax + (120 * k) / W) * H + dy - 34 * k;
      ctx.strokeStyle = 'rgba(245,238,225,0.18)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(x1, y1);
      ctx.quadraticCurveTo((x1 + x2) / 2, Math.max(y1, y2) + 18 * k, x2, y2);
      ctx.stroke();
      for (let i = 1; i < 14; i++) {
        const tt = i / 14;
        const px = (1 - tt) * (1 - tt) * x1 + 2 * (1 - tt) * tt * ((x1 + x2) / 2) + tt * tt * x2;
        const py = (1 - tt) * (1 - tt) * y1 + 2 * (1 - tt) * tt * (Math.max(y1, y2) + 18 * k) + tt * tt * y2;
        const tw = ridotto ? 1 : 0.8 + 0.2 * Math.sin(t * 0.003 + i);
        ctx.fillStyle = `rgba(255,214,140,${(0.25 + 0.75 * luce) * tw})`;
        ctx.beginPath();
        ctx.arc(px, py + 3 * k, 2.2 * k + 0.6, 0, 6.283);
        ctx.fill();
      }

      // Edificio
      const w = 120 * k, h = 46 * k;
      const bx = x - w / 2, by = base - h + 6 * k;
      ctx.fillStyle = '#0b1424';
      ctx.fillRect(bx, by, w, h);
      ctx.beginPath();
      ctx.moveTo(bx - 8 * k, by);
      ctx.lineTo(bx + w / 2, by - 22 * k);
      ctx.lineTo(bx + w + 8 * k, by);
      ctx.fill();

      // Finestre
      for (let i = 0; i < 5; i++) {
        const fx = bx + 12 * k + i * 21.5 * k;
        const fa = 0.12 + 0.88 * luce;
        ctx.fillStyle = `rgba(244,197,106,${fa})`;
        ctx.fillRect(fx, by + 14 * k, 12 * k, 16 * k);
      }

      // Bagliore
      if (luce > 0) {
        const gl = ctx.createRadialGradient(x, by + 20 * k, 0, x, by + 20 * k, 160 * k);
        gl.addColorStop(0, `rgba(244,197,106,${0.28 * luce})`);
        gl.addColorStop(1, 'rgba(244,197,106,0)');
        ctx.fillStyle = gl;
        ctx.fillRect(x - 170 * k, by - 150 * k, 340 * k, 320 * k);
      }
    }

    function ciclo(t: number) {
      if (aperto && accensione < 1) accensione = Math.min(1, accensione + 0.02);
      if (!aperto) accensione = 0;
      disegna(t);
      if (!ridotto && visibile) raf = requestAnimationFrame(ciclo);
    }

    dimensiona();
    if (ridotto) accensione = 1;
    ciclo(0);

    new ResizeObserver(() => {
      dimensiona();
      if (ridotto || !visibile) disegna(performance.now());
    }).observe(canvas);

    window.addEventListener('scroll', () => {
      scrollY = Math.min(window.scrollY, H);
      if (ridotto) disegna(0);
    }, { passive: true });

    new IntersectionObserver(([e]) => {
      visibile = e.isIntersecting && !document.hidden;
      cancelAnimationFrame(raf);
      if (visibile && !ridotto) raf = requestAnimationFrame(ciclo);
    }).observe(canvas);

    document.addEventListener('visibilitychange', () => {
      cancelAnimationFrame(raf);
      visibile = !document.hidden;
      if (visibile && !ridotto) raf = requestAnimationFrame(ciclo);
    });

    document.addEventListener('stato', (e) => {
      aperto = (e as CustomEvent).detail.aperto;
      if (ridotto) {
        accensione = aperto ? 1 : 0;
        disegna(0);
      }
    });
  }
</script>

<style>
  .vista {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(#060c18, #1b2c48 70%, #060c17);
  }
  .vista-canvas {
    width: 100%;
    height: 100%;
  }
</style>
